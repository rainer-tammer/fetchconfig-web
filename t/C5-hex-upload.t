use strict; use warnings;
use Test::More;
use FindBin; use lib "$FindBin::Bin/lib";
use FCWebTest qw(load_cgi make_config);

# HEX uploader helpers (2.05): the highlighting-scheme allow-list and the
# syntax_style header stamping used by do_upload_hex().

my ($cfg, $dir) = make_config();
load_cgi($cfg); main::read_config();

# --- template_syntax_schemes: the dropdown / server-side allow-list ---
my @schemes = main::template_syntax_schemes();
my %s = map { $_ => 1 } @schemes;
ok($s{'auto'},      'auto present');
ok($s{'none'},      'none present');
ok($s{'cisco-ios'}, 'cisco-ios present');
ok($s{'generic'},   'generic present');
ok(!$s{'bogus'},    'unknown scheme absent');
is($schemes[0], 'auto', 'auto is first (the default)');

# A representative generate_template.pl header block.
my $hdr = <<'TMPL';
# Generated by generate_template.pl 9.65 from rtrtst01-telnet.hex
# THIS IS A DRAFT - review every line.
#
# Inferred: transport=telnet
#
prompt_match = #
TMPL

# --- auto: no syntax_style line added ---
unlike(main::template_set_syntax_style($hdr, 'auto'),
       qr/syntax_style/, 'auto adds no syntax_style line');

# --- a concrete scheme is inserted at the END of the header block ---
my $cis = main::template_set_syntax_style($hdr, 'cisco-ios');
like($cis, qr/^# syntax_style: cisco-ios$/m, 'scheme line inserted');
like($cis,
     qr/# Inferred: transport=telnet\n#\n# syntax_style: cisco-ios\nprompt_match/,
     'inserted at end of header, before the body');

# --- none is pinned explicitly ---
like(main::template_set_syntax_style($hdr, 'none'),
     qr/^# syntax_style: none$/m, 'none is pinned');

# --- dedupe: an existing declaration is replaced, not duplicated ---
my $pre = "# head\n# syntax_style: json\nbody\n";
my $re  = main::template_set_syntax_style($pre, 'xml');
my @hits = ($re =~ /syntax_style/g);
is(scalar(@hits), 1, 'existing syntax_style replaced, not duplicated');
like($re,   qr/^# syntax_style: xml$/m, 'replacement scheme present');
unlike($re, qr/json/,                   'old scheme removed');

# --- auto also strips an existing declaration ---
unlike(main::template_set_syntax_style($pre, 'auto'),
       qr/syntax_style/, 'auto strips an existing declaration');

# --- template with no leading comment block: line goes at the top ---
like(main::template_set_syntax_style("line1\nline2\n", 'nexus'),
     qr/^# syntax_style: nexus\nline1/, 'no-header: inserted at top');

# --- hex_looks_like_record_session: the capture magic line ---
ok( main::hex_looks_like_record_session(
      "# record-session  host=rtrtst01.schuler.de  transport=ssh  2026-10-18 14:05:41 +0200\nAAAA\n"),
    'real record-session banner accepted');
ok( main::hex_looks_like_record_session("#record-session host=x\n"), 'no space after # accepted');
ok( main::hex_looks_like_record_session("\n  # record-session host=x\n"), 'leading blank/space tolerated');
ok(!main::hex_looks_like_record_session("# some other file\n00 01 02\n"), 'other comment rejected');
ok(!main::hex_looks_like_record_session("00 01 02 03\n"), 'bare hex without banner rejected');
ok(!main::hex_looks_like_record_session(''), 'empty rejected');
ok(!main::hex_looks_like_record_session(undef), 'undef rejected');

done_testing();
