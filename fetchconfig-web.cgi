# View a device-table backup (read-only). Admin-only; strict name check.
# Passwords are masked in the display like every other config view.
sub show_view_backup {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You are not allowed to use Tools.</p>\n};
        print page_foot();
        return;
    }

    my $name = $cgi->param('name') // '';
    my $path = resolve_backup_path($name);
    print page_head('View backup', $user, 'full');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=tools') . qq{">&larr; Tools</a></p>\n};
    print qq{<h1>Backup: } . esc($name) . qq{</h1>\n};
    unless ($path) {
        print qq{<p class="error">No such backup.</p>\n};
        print page_foot();
        return;
    }

    my $content = '';
    if (open(my $fh, '<', $path)) { local $/; $content = <$fh>; close($fh); }
    # Admin-only tool. Passwords are masked by default; the "Mask passwords"
    # checkbox on the Tools page (unchecked) passes unmask=1 to show them in
    # plain text. esc() masks + HTML-escapes; CGI::escapeHTML only escapes.
    my $unmask = ($cgi->param('unmask') // '') eq '1';
    my $body = $unmask ? CGI::escapeHTML($content) : esc($content);
    print qq{<div class="config-wrap">\n};
    print copy_button_html();
    print qq{<pre class="config" id="config-content">} . $body . qq{</pre>\n};
    print qq{</div>\n};
    print copy_button_script();
    print top_bottom_nav();
    print page_foot();
}

# Restore the device table from a backup. Admin-only, POST + CSRF, strict
# name check. Backs the CURRENT table up first (so restore is undoable),
# then writes the chosen backup in place via the shared safe writer.
sub do_restore_backup {
    my ($user) = @_;
    unless (user_may_use_tools($user)) {
        print $cgi->header(-type => 'text/plain', -status => '403 Forbidden');
        print "You are not allowed to use Tools.\n";
        return;
    }
    my $name = $cgi->param('name') // '';
    my $path = resolve_backup_path($name);
    unless ($path) {
        redirect_to_tools(err => "No such backup.");
        return;
    }
    my $restore_content = '';
    unless (open(my $fh, '<', $path)) {
        redirect_to_tools(err => "Could not read backup $name: $!.");
        return;
    } else {
        local $/; $restore_content = <$fh>; close($fh);
    }

    # Current bytes, so the pre-restore backup captures exactly what's live.
    my ($current, $rerr) = slurp_device_table();
    $current = '' unless defined $current;
    # No mtime guard here: a restore is an intentional "make it this" action.
    my ($ok, $info) = backup_and_write_table($current, $restore_content);
    if (!$ok) {
        redirect_to_tools(err => $info);
        return;
    }
    redirect_to_tools(msg => "Device table restored from $name. "
        . "(Previous table backed up as $info.)");
}

# Delete a device-table backup. Admin-only, POST + CSRF, strict name check.
sub do_delete_backup {
    my ($user) = @_;
    unless (user_may_use_tools($user)) {
        print $cgi->header(-type => 'text/plain', -status => '403 Forbidden');
        print "You are not allowed to use Tools.\n";
        return;
    }
    my $name = $cgi->param('name') // '';
    my $path = resolve_backup_path($name);
    unless ($path) {
        redirect_to_tools(err => "No such backup.");
        return;
    }
    if (unlink($path)) {
        redirect_to_tools(msg => "Deleted backup $name.");
    } else {
        redirect_to_tools(err => "Could not delete $name: $!.");
    }
}

# Delete device-table backups older than N days, ALWAYS keeping the single
# newest backup (by the timestamp in its filename) even if it is older than
# N days. Age is taken from the filename timestamp, not the file mtime. N
# must be an integer >= 1. POST + CSRF (state-changing); admin only.
sub do_delete_old_backups {
    my ($user) = @_;
    unless (user_may_use_tools($user)) {
        print $cgi->header(-type => 'text/plain', -status => '403 Forbidden');
        print "You are not allowed to use Tools.\n";
        return;
    }
    my $days = $cgi->param('days') // '';
    unless ($days =~ /^\d+$/ && $days >= 1) {
        redirect_to_tools(err => "Please enter a whole number of days (1 or more).");
        return;
    }

    my $backups = list_table_backups();
    # Order by the filename timestamp (newest first); the first one is kept.
    my @dated = sort { ($b->{epoch} // 0) <=> ($a->{epoch} // 0) }
                map  { { %$_, epoch => backup_epoch_from_name($_->{name}) } }
                @$backups;
    if (@dated <= 1) {
        redirect_to_tools(msg => "Nothing to delete: there is no backup older than the newest one.");
        return;
    }
    my $newest = shift @dated;   # never deleted
    my $cutoff = time() - $days * 86400;

    my ($deleted, @failed) = (0);
    for my $b (@dated) {
        next unless defined $b->{epoch} && $b->{epoch} < $cutoff;
        my $path = resolve_backup_path($b->{name});   # strict name check
        next unless $path;
        if (unlink($path)) { $deleted++ } else { push @failed, $b->{name} }
    }

    my $msg = "Deleted $deleted backup" . ($deleted == 1 ? '' : 's')
            . " older than $days day" . ($days == 1 ? '' : 's')
            . " (newest backup $newest->{name} kept).";
    if (@failed) {
        redirect_to_tools(err => "$msg Could not delete: " . join(', ', @failed) . ".");
    } else {
        redirect_to_tools(msg => $msg);
    }
}

# Run the read-only orphaned-backup check and show its transcript, in the
# same layout as Backup Now / Check Empty Backups.
sub show_orphan_check {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You are not allowed to use Tools.</p>\n};
        print page_foot();
        return;
    }

    print page_head('Check for orphaned backups', $user, 'checkout');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=tools') . qq{">&larr; Tools</a></p>\n};
    print qq{<h1>Check for orphaned backups</h1>\n};
    print qq{<p class="muted">Result of <code>fetchconfig.pl -o</code>. Nothing }
        . qq{is deleted.</p>\n};

    my ($output, $status, $err) = run_orphan_check();
    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } elsif (defined $status && $status == 0) {
        print qq{<p class="success">No orphaned backups found.</p>\n};
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">}
            . esc(($output ne '') ? $output : "(fetchconfig.pl -o produced no output -- nothing orphaned.)")
            . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    } elsif (defined $status && $status == 1) {
        # Exit 1 from -o means "orphaned backups were found" -- expected, not
        # an error. Use "Delete orphaned backups" on the Tools page to
        # remove them.
        print qq{<p class="success">Orphaned backups were found (listed below). }
            . qq{Use <strong>Delete orphaned backups</strong> on the Tools page to remove them.</p>\n};
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">} . esc($output) . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    } else {
        print qq{<p class="error">fetchconfig.pl -o finished with exit status }
            . esc(defined $status ? $status : '?') . qq{ -- see output below.</p>\n};
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">} . esc($output) . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    }

    print qq{<p><a class="btn" href="} . esc(script_url() . '?action=tools')
        . qq{">Return to Tools</a></p>\n};
    print page_foot();
}

# Run the destructive orphaned-backup delete and show its transcript. POST +
# CSRF (state-changing), admin only, re-checked here.
sub do_orphan_delete {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You are not allowed to use Tools.</p>\n};
        print page_foot();
        return;
    }

    print page_head('Delete orphaned backups', $user, 'checkout');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=tools') . qq{">&larr; Tools</a></p>\n};
    print qq{<h1>Delete orphaned backups</h1>\n};
    print qq{<p class="muted">Result of <code>fetchconfig.pl -o -D</code>.</p>\n};

    my ($output, $status, $err) = run_orphan_delete();
    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } else {
        if (defined $status && $status == 0) {
            print qq{<p class="success">Done. Nothing needed deleting, or every }
                . qq{orphaned backup found was deleted successfully.</p>\n};
        } else {
            # With -o -D, exit 1 means at least one deletion failed.
            print qq{<p class="error">One or more deletions failed (exit }
                . esc(defined $status ? $status : '?') . qq{) -- see the log below.</p>\n};
        }
        my $shown = ($output ne '') ? $output
                  : "(fetchconfig.pl -o -D produced no output -- nothing orphaned.)";
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">} . esc($shown) . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    }

    print qq{<p><a class="btn" href="} . esc(script_url() . '?action=tools')
        . qq{">Return to Tools</a></p>\n};
    print page_foot();
}

