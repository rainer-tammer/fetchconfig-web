ICONB64
    $raw =~ s/\s+//g;
    $raw;
};

# --------------------------------------------------------------------------
# Bootstrap
# --------------------------------------------------------------------------
my $cgi = CGI->new;
# Byte-oriented output: the page is declared UTF-8 (HTTP header + <meta
# charset>), and config content is passed through as raw UTF-8 bytes. We use
# raw (not ':utf8') STDOUT so those bytes are emitted unchanged -- a ':utf8'
# layer double-encodes already-UTF-8 bytes on some Perls (older AIX builds),
# producing mojibake. All other output the app generates is ASCII.
binmode(STDOUT);

# Load all site config from $CONFIG_FILE before doing anything else. A
# failure here (missing file, missing required key) is shown as a plain
# page rather than a bare 500, since nothing downstream can work without it.
if (my $cfg_err = read_config()) {
    # Show the misconfiguration on the normal styled Login page (same as a
    # login failure), not as a bare text/plain 500. read_config() only needs
    # $APP_TITLE/$LOGO_BASE64 (both always set) to render, and because it
    # returned an error nothing is dispatched -- so, e.g., an out-of-range
    # MAX_PARALLEL_SCAN both shows cleanly here AND prevents any scan (or any
    # other action) from running.
    show_login_form("Server misconfiguration: $cfg_err");
    exit 0;
}

if (!-d $SESSION_DIR) {
    make_path($SESSION_DIR, { mode => 0700 }) or do {
        print $cgi->header('text/plain');
        print "Server misconfiguration: cannot create session directory $SESSION_DIR: $!\n";
        exit 0;
    };
}

# Actions that change server state must be POST (so they can't be triggered
# by a bookmark, a prefetch, or an <img src=...> tag) AND must carry a
# valid per-session CSRF token. Read-only actions (viewing lists, configs,
# diffs, the user/help pages) stay GET-friendly.
my %STATE_CHANGING = map { $_ => 1 }
    qw(login logout change_password reset_password add_user delete_user set_edit_right set_admin_right backup_now save_table preview_table edit_table_from_form orphan_delete bulk_save restore_backup delete_backup delete_old_backups empty_delete);

# The request is dispatched from main(), called at the very END of this
# file -- after all the static data tables further down (the option
# catalog, $SECRET_KEEP, etc.) have been assigned. If dispatch ran here at
# the top instead, those `my ... = (...)` assignments (which execute in
# source order) wouldn't have run yet, and the editor would see empty
# catalogs.
sub main {
    my $action = $cgi->param('action') || '';
    my $method = $cgi->request_method() || 'GET';

    if ($STATE_CHANGING{$action} && $method ne 'POST') {
        # A state-changing action arrived as GET (or HEAD, etc.). Refuse it
        # outright rather than acting on it.
        print $cgi->header(-type => 'text/plain', -status => '405 Method Not Allowed',
                           -allow => 'POST');
        print "This action requires a POST request.\n";
        return;
    }

    if ($action eq 'login') {
        do_login();
    } elsif ($action eq 'logout') {
        do_logout();
    } else {
        my ($sid, $user, $csrf) = current_session();
        if (!defined $user) {
            show_login_form();
        }
        # CSRF check for the authenticated state-changing actions (login/logout
        # are handled separately: login has no session yet, and logout is
        # covered below).
        elsif ($STATE_CHANGING{$action} && !csrf_ok($csrf)) {
            print $cgi->header(-type => 'text/plain', -status => '403 Forbidden');
            print "Invalid or missing CSRF token. Go back, reload the page, and try again.\n";
            return;
        }
        elsif ($action eq 'compare') {
            show_compare($user);
        } elsif ($action eq 'sidebyside') {
            show_side_by_side($user);
        } elsif ($action eq 'checkempty') {
            show_check_empty($user);
        } elsif ($action eq 'checksuffix') {
            show_check_suffix($user);
        } elsif ($action eq 'backup_now') {
            show_backup_now($user);
        } elsif ($action eq 'user') {
            show_user_page($user);
        } elsif ($action eq 'change_password') {
            do_change_password($user);
        } elsif ($action eq 'reset_password_form') {
            show_reset_password_form($user);
        } elsif ($action eq 'reset_password') {
            do_reset_password($user);
        } elsif ($action eq 'add_user') {
            do_add_user($user);
        } elsif ($action eq 'delete_user') {
            do_delete_user($user);
        } elsif ($action eq 'set_edit_right') {
            do_set_edit_right($user);
        } elsif ($action eq 'set_admin_right') {
            do_set_admin_right($user);
        } elsif ($action eq 'help') {
            show_help($user);
        } elsif ($action eq 'setup') {
            show_setup($user);
        } elsif ($action eq 'status') {
            show_status_page($user);
        } elsif ($action eq 'tools') {
            show_tools($user);
        } elsif ($action eq 'view_log') {
            show_fetchconfig_log($user);
        } elsif ($action eq 'view_templates') {
            show_view_templates($user);
        } elsif ($action eq 'view_template') {
            show_view_template($user);
        } elsif ($action eq 'orphan_check') {
            show_orphan_check($user);
        } elsif ($action eq 'orphan_delete') {
            do_orphan_delete($user);
        } elsif ($action eq 'empty_check') {
            show_empty_check($user);
        } elsif ($action eq 'empty_delete') {
            do_empty_delete($user);
        } elsif ($action eq 'view_backup') {
            show_view_backup($user);
        } elsif ($action eq 'check_backups_one') {
            do_check_backups_one($user);
        } elsif ($action eq 'check_empty_one') {
            do_check_empty_one($user);
        } elsif ($action eq 'check_suffix_one') {
            do_check_suffix_one($user);
        } elsif ($action eq 'compare_backups') {
            show_compare_backups($user);
        } elsif ($action eq 'restore_backup') {
            do_restore_backup($user);
        } elsif ($action eq 'delete_backup') {
            do_delete_backup($user);
        } elsif ($action eq 'delete_old_backups') {
            do_delete_old_backups($user);
        } elsif ($action eq 'edit_table') {
            show_edit_table($user);
        } elsif ($action eq 'edit_table_from_form') {
            show_edit_table($user);
        } elsif ($action eq 'preview_table') {
            show_preview_table($user);
        } elsif ($action eq 'save_table') {
            do_save_table($user);
        } elsif ($action eq 'bulk_edit') {
            show_bulk_edit($user);
        } elsif ($action eq 'bulk_save') {
            do_bulk_save($user);
        } elsif ($action eq 'download_config') {
            download_tplink_config($user, scalar $cgi->param('dev'), scalar $cgi->param('idx'));
        } elsif ($action eq 'download_latest') {
            download_latest_config($user, scalar $cgi->param('dev'));
        } else {
            my $dev = $cgi->param('dev');
            my $idx = $cgi->param('idx');
            if (defined $dev && $dev ne '' && defined $idx && $idx ne '') {
                show_backup_content($user, $dev, $idx);
            } elsif (defined $dev && $dev ne '') {
                show_backup_list($user, $dev);
            } else {
                show_device_list($user);
            }
        }
    }
}

# =============================================================================
# User store -- PostgreSQL (DBI). A fresh connection per request; callers
# close it (or let process exit close it). Every query is parameterized.
# =============================================================================

# Open a connection to the user database. Returns $dbh or undef on failure;
# on failure the caller shows a "server misconfiguration" style message
# rather than leaking connection details.
sub db_connect {
    my $dsn = "dbi:Pg:dbname=$DBinst;host=$DBhost";
    my $dbh = DBI->connect($dsn, $DBuser, $DBpass,
        { RaiseError => 0, PrintError => 0, AutoCommit => 1 });
    return $dbh;   # undef on failure
}

# Fetch one user's row as a hashref
# { username, pass_hash, edit_device_table, admin_function } or undef if
# not found / on error.
sub db_get_user {
    my ($dbh, $username) = @_;
    my $row = $dbh->selectrow_hashref(
        'SELECT username, pass_hash, edit_device_table, admin_function FROM users WHERE username = ?',
        undef, $username);
    return $row;
}

# All users, ordered by username, as an arrayref of hashrefs. Empty list on
# error (callers treat that the same as "no users").
sub db_all_users {
    my ($dbh) = @_;
    my $rows = $dbh->selectall_arrayref(
        'SELECT username, pass_hash, edit_device_table, admin_function FROM users ORDER BY username',
        { Slice => {} });
    return $rows || [];
}

# True if the user exists.
sub db_user_exists {
    my ($dbh, $username) = @_;
    my ($x) = $dbh->selectrow_array(
        'SELECT 1 FROM users WHERE username = ?', undef, $username);
    return $x ? 1 : 0;
}

# Insert a new user. Returns (1) on success or (0, $errmsg) on failure.
sub db_add_user {
    my ($dbh, $username, $hash, $edit, $admin) = @_;
    my $ok = $dbh->do(
        'INSERT INTO users (username, pass_hash, edit_device_table, admin_function) VALUES (?, ?, ?, ?)',
        undef, $username, $hash, $edit ? 1 : 0, $admin ? 1 : 0);
    return $ok ? (1) : (0, $dbh->errstr);
}

# Update a user's password hash. Returns (1) or (0, $errmsg).
sub db_set_password {
    my ($dbh, $username, $hash) = @_;
    my $ok = $dbh->do('UPDATE users SET pass_hash = ? WHERE username = ?',
        undef, $hash, $username);
    return $ok ? (1) : (0, $dbh->errstr);
}

# Update a user's edit-device-table flag. Returns (1) or (0, $errmsg).
sub db_set_edit_flag {
    my ($dbh, $username, $edit) = @_;
    my $ok = $dbh->do('UPDATE users SET edit_device_table = ? WHERE username = ?',
        undef, $edit ? 1 : 0, $username);
    return $ok ? (1) : (0, $dbh->errstr);
}

# Update a user's admin_function flag. Returns (1) or (0, $errmsg).
sub db_set_admin_flag {
    my ($dbh, $username, $admin) = @_;
    my $ok = $dbh->do('UPDATE users SET admin_function = ? WHERE username = ?',
        undef, $admin ? 1 : 0, $username);
    return $ok ? (1) : (0, $dbh->errstr);
}

# Delete a user. Returns (1) or (0, $errmsg).
sub db_delete_user {
    my ($dbh, $username) = @_;
    my $ok = $dbh->do('DELETE FROM users WHERE username = ?', undef, $username);
    return $ok ? (1) : (0, $dbh->errstr);
}

# True if $username has full admin powers: the built-in $PROTECTED_USER
# account always does; any other user does if its admin_function flag is
# set. A user with admin_function behaves exactly like the built-in admin
# (user management, Tools, Setup). Takes an open $dbh.
sub user_is_admin {
    my ($dbh, $username) = @_;
    return 1 if defined $username && $username eq $PROTECTED_USER;
    return 0 unless defined $username;
    my $u = db_get_user($dbh, $username);
    return ($u && $u->{admin_function}) ? 1 : 0;
}

# True if $username is allowed to view/edit the device table: any admin
# (built-in or admin_function) always is; otherwise it depends on the
# per-user edit_device_table flag. Takes an open $dbh.
sub user_may_edit_table {
    my ($dbh, $username) = @_;
    return 1 if user_is_admin($dbh, $username);
    my $u = db_get_user($dbh, $username);
    return ($u && $u->{edit_device_table}) ? 1 : 0;
}

# Verify a plaintext password against an htpasswd hash. Supports the
# salted formats commonly produced by `htpasswd`:
#   $apr1$salt$hash       -- htpasswd default on many systems (Apache MD5)
#   $1$/$5$/$6$salt$hash  -- glibc crypt() MD5/SHA-256/SHA-512
#   <2-char-salt>hash     -- traditional DES crypt (htpasswd -d)
# The unsalted {SHA} format (htpasswd -s) is deliberately NOT accepted: it
# is trivially brute-forced if the user table leaks. bcrypt ($2y$) is NOT
# supported without an extra CPAN module -- see README.
sub verify_password {
    my ($plain, $hash) = @_;
    return 0 unless defined $hash && length $hash;

    if ($hash =~ /^\$apr1\$/) {
        return secure_compare(md5_crypt($plain, $hash, '$apr1$'), $hash);
    }
    elsif ($hash =~ /^\$1\$/) {
        return secure_compare(md5_crypt($plain, $hash, '$1$'), $hash);
    }
    elsif ($hash =~ /^\$(2[aby]?)\$/) {
        # bcrypt - not implemented in pure perl here.
        warn "fetchconfig-web: bcrypt hash encountered but unsupported (see README)\n";
        return 0;
    }
    else {
        # $5$ / $6$ (glibc SHA-256/512) or traditional DES crypt: delegate
        # to the system crypt() function, which understands these natively
        # on Linux. (Note: AIX's native crypt() may not support $5$/$6$ --
        # traditional DES-format htpasswd entries still work everywhere.)
        my $got = crypt($plain, $hash);
        return defined($got) && secure_compare($got, $hash);
    }
}

# Pure-Perl implementation of the MD5-crypt algorithm (PHK's FreeBSD/Apache
# MD5 crypt). Used for both "$1$" and "$apr1$" hashes -- identical
# algorithm, only the magic string differs. Verified against
# `openssl passwd -apr1` / `openssl passwd -1` reference output.
sub md5_crypt {
    my ($password, $existing_hash, $magic) = @_;

    # Pull the salt out of the existing hash: $magic$salt$hash
    my $salt = $existing_hash;
    $salt =~ s/^\Q$magic\E//;
    $salt =~ s/\$.*$//;
    $salt = substr($salt, 0, 8);

    my $ctx1 = Digest::MD5->new;
    $ctx1->add($password);
    $ctx1->add($magic);
    $ctx1->add($salt);

    my $ctx2 = Digest::MD5->new;
    $ctx2->add($password);
    $ctx2->add($salt);
    $ctx2->add($password);
    my $final = $ctx2->digest;

    my $pwlen = length($password);
    my $i = $pwlen;
    while ($i > 0) {
        $ctx1->add(substr($final, 0, $i > 16 ? 16 : $i));
        $i -= 16;
    }

    $i = $pwlen;
    while ($i) {
        if ($i & 1) {
            $ctx1->add("\0");
        } else {
            $ctx1->add(substr($password, 0, 1));
        }
        $i >>= 1;
    }

    $final = $ctx1->digest;

    for my $round (0 .. 999) {
        my $ctx3 = Digest::MD5->new;
        $ctx3->add($round & 1 ? $password : $final);
        $ctx3->add($salt) if ($round % 3);
        $ctx3->add($password) if ($round % 7);
        $ctx3->add($round & 1 ? $final : $password);
        $final = $ctx3->digest;
    }

    my @itoa64 = ('.', '/', 0 .. 9, 'A' .. 'Z', 'a' .. 'z');
    my @f = unpack('C16', $final);
    my $result = '';

    for my $g ([0, 6, 12], [1, 7, 13], [2, 8, 14], [3, 9, 15], [4, 10, 5]) {
        my $v = ($f[$g->[0]] << 16) | ($f[$g->[1]] << 8) | $f[$g->[2]];
        for (1 .. 4) {
            $result .= $itoa64[$v & 0x3f];
            $v >>= 6;
        }
    }
    my $v = $f[11];
    for (1 .. 2) {
        $result .= $itoa64[$v & 0x3f];
        $v >>= 6;
    }

    return "$magic$salt\$$result";
}

# Generate a fresh Apache MD5 ($apr1$) hash for a new/changed password,
# with a random 8-char salt. Pure Perl -- no htpasswd binary needed. The
# output is byte-for-byte what `openssl passwd -apr1` produces, and
# verify_password() reads it back via md5_crypt().
sub apr1_hash {
    my ($password) = @_;
    my @itoa64 = ('.', '/', 0 .. 9, 'A' .. 'Z', 'a' .. 'z');
    my $bytes;
    if (open(my $rf, '<:raw', '/dev/urandom')) {
        read($rf, $bytes, 8);
        close($rf);
    } else {
        $bytes = join('', map { chr(int(rand(256))) } 1 .. 8);
    }
    my $salt = '';
    $salt .= $itoa64[ ord(substr($bytes, $_, 1)) & 0x3f ] for 0 .. 7;
    return md5_crypt($password, "\$apr1\$$salt\$", '$apr1$');
}

sub new_session_id {
    my $bytes;
    if (open(my $rf, '<:raw', '/dev/urandom')) {
        read($rf, $bytes, 24);
        close($rf);
    } else {
        # Fallback (should not happen on Linux/AIX)
        $bytes = join('', map { chr(int(rand(256))) } 1 .. 24);
    }
    return unpack('H*', $bytes);
}

sub create_session {
    my ($username, $pw_warn) = @_;
    my $sid = new_session_id();
    my $path = "$SESSION_DIR/$sid";
    my $expiry = time() + $SESSION_TTL;
    # Per-session CSRF token: a second independent random value, kept
    # server-side in the session file (never in the cookie). Required as a
    # hidden field on every state-changing POST -- see csrf_ok(). Because
    # it lives only in the session file and is emitted only into this app's
    # own pages, a cross-site attacker can't read it, so they can't forge a
    # request that carries the right token.
    my $csrf = new_session_id();
    # 4th line: default-password warning marker ('admin', 'other', or empty).
    # Set at login when the account is still on $DEFAULT_PASSWORD; cleared
    # (session rewritten) once the password is changed. Kept out of the
    # cookie like everything else.
    $pw_warn = '' unless defined $pw_warn;
    open(my $fh, '>', $path) or die "Cannot create session file: $!";
    flock($fh, LOCK_EX);
    print $fh "$username\n$expiry\n$csrf\n$pw_warn\n";
    close($fh);
    chmod(0600, $path);
    return $sid;
}

# Load a session, returning ($username, $csrf_token, $pw_warn) or () if
# invalid / expired. current_user() below wraps this for the common "just
# the name" case; handlers that need the token or warning call this or
# current_session() directly. Old 3-line session files (no warning line)
# still load, with $pw_warn defaulting to ''.
sub load_session {
    my ($sid) = @_;
    return () unless defined $sid && $sid =~ /^[0-9a-f]{48}$/;
    my $path = "$SESSION_DIR/$sid";
    return () unless -f $path;
    open(my $fh, '<', $path) or return ();
    my $username = <$fh>;
    my $expiry   = <$fh>;
    my $csrf     = <$fh>;
    my $pw_warn  = <$fh>;
    close($fh);
    return () unless defined $username && defined $expiry;
    chomp($username, $expiry);
    chomp($csrf) if defined $csrf;
    chomp($pw_warn) if defined $pw_warn;
    $pw_warn = '' unless defined $pw_warn;
    if ($expiry < time()) {
        unlink($path);
        return ();
    }
    # Idle timeout: the session lives for SESSION_TTL after the LAST activity,
    # not after login. Slide the expiry forward on every successful load.
    #
    # This MUST be race-safe: under MAX_PARALLEL_SCAN > 1 several requests load
    # the same session file at once. A plain open('>', $path) truncates the
    # file to zero *before* any lock, so a concurrent reader could read it
    # empty, treat the session as invalid, and serve the login page (which the
    # scan's fetch then received as HTML instead of JSON). Instead, write the
    # new contents to a temp file in the same directory and rename() it over
    # the session file: rename is atomic on POSIX, so a concurrent reader
    # always sees either the complete old file or the complete new one.
    my $new_expiry = time() + $SESSION_TTL;
    my $data = "$username\n$new_expiry\n" . ($csrf // '') . "\n$pw_warn\n";
    my ($tfh, $tmp) = eval { tempfile('sess-XXXXXXXX', DIR => $SESSION_DIR) };
    if ($tfh) {
        print $tfh $data;
        close($tfh);
        chmod(0600, $tmp);
        # If rename fails (e.g. cross-device, which shouldn't happen in one
        # dir), fall back to leaving the old file untouched and clean up.
        unless (rename($tmp, $path)) {
            unlink($tmp);
        }
    }
    return ($username, $csrf, $pw_warn);
}

sub destroy_session {
    my ($sid) = @_;
    return unless defined $sid && $sid =~ /^[0-9a-f]{48}$/;
    unlink("$SESSION_DIR/$sid");
}

sub current_user {
    my ($username) = current_session();
    return $username;
}

# Returns ($sid, $username, $csrf_token, $pw_warn) for the request's
# session, or () if not logged in. Kept separate from current_user() so the
# dispatcher and forms can get at the token, sid, and default-password
# warning without re-reading the cookie each time.
sub current_session {
    my %cookies = CGI::Cookie->fetch;
    my $sid = $cookies{$COOKIE_NAME} ? $cookies{$COOKIE_NAME}->value : undef;
    return () unless defined $sid;
    my ($username, $csrf, $pw_warn) = load_session($sid);
    return () unless defined $username;
    return ($sid, $username, $csrf, $pw_warn);
}

# Constant-time string comparison, to avoid leaking how many leading
# characters of a secret matched via response timing. Used for CSRF token
# checks; also suitable for comparing password hashes.
sub secure_compare {
    my ($a, $b) = @_;
    return 0 unless defined $a && defined $b;
    return 0 if length($a) != length($b);
    my $diff = 0;
    for my $i (0 .. length($a) - 1) {
        $diff |= ord(substr($a, $i, 1)) ^ ord(substr($b, $i, 1));
    }
    return $diff == 0;
}

# True if the request carries a valid CSRF token matching the session's.
# Every state-changing POST handler calls this first. The token is read
# from the "csrf" form field and compared (constant-time) against the one
# stored in the session file at login.
sub csrf_ok {
    my ($session_csrf) = @_;
    my $submitted = $cgi->param('csrf');
    return defined $session_csrf && defined $submitted
        && secure_compare($session_csrf, $submitted);
}

# The current session's CSRF token (or '' if somehow not logged in), for
# embedding as a hidden field in state-changing forms. Reads the session
# fresh; cheap enough (one small file read) and keeps callers from having
# to thread the token through every function signature.
sub csrf_token {
    my (undef, undef, $csrf) = current_session();
    return defined $csrf ? $csrf : '';
}

# Hidden CSRF input for pasting into a <form>. Value is a 48-char hex
# token, so it's safe unescaped, but esc() it anyway for belt-and-braces.
sub csrf_field {
    return qq{<input type="hidden" name="csrf" value="} . esc(csrf_token()) . qq{">\n};
}

# =============================================================================
# Actions
# =============================================================================

sub do_login {
    my $username = $cgi->param('username') // '';
    my $password = $cgi->param('password') // '';

    if ($username eq '' || $password eq '') {
        show_login_form('Please enter a username and password.');
        return;
    }

    my $dbh = db_connect();
    if (!$dbh) {
        show_login_form('Server misconfiguration: cannot reach the user database.');
        return;
    }

    my $u = db_get_user($dbh, $username);
    $dbh->disconnect;

    if ($u && verify_password($password, $u->{pass_hash})) {
        # Flag the session if this account is still on the default password,
        # so a "change it" banner shows until they do. The message differs
        # for admin vs. everyone else (see the banner in page_head()).
        my $pw_warn = '';
        if ($password eq $DEFAULT_PASSWORD) {
            $pw_warn = ($username eq $PROTECTED_USER) ? 'admin' : 'other';
        }
        my $sid = create_session($username, $pw_warn);
        my $cookie = CGI::Cookie->new(
            -name     => $COOKIE_NAME,
            -value    => $sid,
            -httponly => 1,
            -samesite => 'Lax',   # defence-in-depth alongside the CSRF token
            -path     => '/',
            # -secure => 1,   # uncomment once served over HTTPS
        );
        print $cgi->header(-cookie => $cookie, -location => script_url(), -status => '302 Found');
    } else {
        # Slow down online brute-force attempts. Applied on every failure --
        # unknown user or wrong password alike -- so timing doesn't reveal
        # which one was wrong.
        sleep 2;
        show_login_form('Invalid username or password.');
    }
}

sub do_logout {
    my %cookies = CGI::Cookie->fetch;
    my $sid = $cookies{$COOKIE_NAME} ? $cookies{$COOKIE_NAME}->value : undef;

    # Logout is dispatched before the main authenticated CSRF check, so
    # validate the token here (POST is already enforced up top). Prevents a
    # cross-site page from force-logging-out the user. An invalid token
    # just bounces to wherever script_url() points without destroying the
    # session.
    my ($username, $csrf) = defined $sid ? load_session($sid) : ();
    if (defined $username && csrf_ok($csrf)) {
        destroy_session($sid);
        my $cookie = CGI::Cookie->new(-name => $COOKIE_NAME, -value => '', -path => '/',
                                      -httponly => 1, -samesite => 'Lax', -expires => '-1d');
        print $cgi->header(-cookie => $cookie, -location => script_url(), -status => '302 Found');
    } else {
        print $cgi->header(-location => script_url(), -status => '302 Found');
    }
}

sub script_url {
    return $cgi->url(-absolute => 1);
}

# --------------------------------------------------------------------------
# Views
# --------------------------------------------------------------------------

sub show_login_form {
    my ($error) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    print page_head('Login');
    print qq{<div class="login-box">\n};
    print qq{<img class="login-icon" src="data:image/png;base64,$LOGIN_ICON_BASE64" }
        . qq{alt="" width="100" height="100">\n};
    print qq{<h1>Log in</h1>\n};
    if ($error) {
        print qq{<p class="error">} . esc($error) . qq{</p>\n};
    }
    print $cgi->start_form(-method => 'POST', -action => script_url());
    print qq{<input type="hidden" name="action" value="login">\n};
    print qq{<label>Username<br>};
    print $cgi->textfield(-name => 'username', -autocomplete => 'username');
    print qq{</label><br>\n};
    print qq{<label>Password<br>};
    print $cgi->password_field(-name => 'password', -autocomplete => 'current-password');
    print qq{</label><br>\n};
    print $cgi->submit(-value => 'Log in');
    print $cgi->end_form;
    print qq{</div>\n};
    print page_foot();
}

sub show_device_list {
    my ($user) = @_;
    # Time how long reading + parsing the device table takes, to show the
    # user as feedback in the statistics panel.
    my $t0 = [Time::HiRes::gettimeofday()];
    my ($devices, $err) = read_device_ids();
    my $load_secs = Time::HiRes::tv_interval($t0);

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    print page_head('Devices', $user, 'full');
    print qq{<h1>Devices</h1>\n};

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } elsif (!@$devices) {
        print qq{<p>No devices found in the device table.</p>\n};
    } else {
        # Distinct models actually in use, for the model dropdown and stats.
        my %by_model;
        $by_model{ $_->{model} }++ for @$devices;
        my $total = scalar @$devices;
        my @models = sort keys %by_model;

        print qq{<div class="filter-row">\n};
        print qq{<select id="model-filter" class="filter-select">\n};
        print qq{<option value="">(all models)</option>\n};
        for my $m (@models) {
            print qq{<option value="} . esc(lc $m) . qq{">} . esc($m) . qq{</option>\n};
        }
        print qq{</select>\n};
        print qq{<input type="text" id="dev-filter" class="filter-box" }
            . qq{placeholder="Filter device&hellip;" autocomplete="off">\n};
        print qq{<input type="text" id="host-filter" class="filter-box" }
            . qq{placeholder="Filter hostname&hellip;" autocomplete="off">\n};
        print qq{<input type="text" id="comment-filter" class="filter-box" }
            . qq{placeholder="Filter comment&hellip;" autocomplete="off">\n};
        print qq{<button type="button" id="clear-filter" class="btn">Clear filter</button>\n};
        print qq{<label class="page-size-label">Per page }
            . qq{<select id="dev-page-size" class="filter-select">}
            . qq{<option value="0">All</option>}
            . qq{<option value="10">10</option>}
            . qq{<option value="25">25</option>}
            . qq{<option value="50">50</option>}
            . qq{<option value="100" selected>100</option>}
            . qq{</select></label>\n};
        print qq{</div>\n};

        # Two-column layout: the device table on the left, the statistics
        # panel in the upper-right corner.
        print qq{<div class="dev-layout">\n};
        print qq{<div class="dev-main">\n};

        # Pager (Prev / page info / Next). Hidden by JS when everything fits
        # on one page.
        print qq{<div id="devlist-pager" class="dev-pager" style="display:none;">}
            . qq{<button type="button" class="btn btn-small" id="devlist-first">&laquo; First</button>}
            . qq{<button type="button" class="btn btn-small" id="devlist-prev">&larr; Prev</button>}
            . qq{<span id="devlist-pageinfo" class="pageinfo"></span>}
            . qq{<button type="button" class="btn btn-small" id="devlist-next">Next &rarr;</button>}
            . qq{<button type="button" class="btn btn-small" id="devlist-last">Last &raquo;</button>}
            . qq{</div>\n};

        print qq{<table class="list" id="dev-table">\n}
            . qq{<tr>}
            . qq{<th class="sortable" data-key="model">Model<span class="sort-ind"></span></th>}
            . qq{<th class="sortable" data-key="dev">Device-ID<span class="sort-ind"></span></th>}
            . qq{<th class="sortable" data-key="host">Hostname<span class="sort-ind"></span></th>}
            . qq{<th>Comment</th>}
            . qq{</tr>\n};
        for my $d (@$devices) {
            my $link = script_url() . '?dev=' . CGI::escape($d->{id});
            # data-host = lowercased host for the substring filter;
            # data-host-key = a sort key that orders IPv4 numerically first,
            # then hostnames/FQDNs (and IPv6) alphabetically (see host_sort_key).
            print qq{<tr data-model="} . esc(lc $d->{model}) . qq{" }
                . qq{data-dev="} . esc(lc $d->{id}) . qq{" }
                . qq{data-host="} . esc(lc $d->{host}) . qq{" }
                . qq{data-host-key="} . esc(host_sort_key($d->{host})) . qq{" }
                . qq{data-comment="} . esc(lc $d->{comment}) . qq{">}
                . qq{<td>} . esc($d->{model}) . qq{</td>}
                . qq{<td><a href="} . esc($link) . qq{">} . esc($d->{id}) . qq{</a></td>}
                . qq{<td>} . esc($d->{host}) . qq{</td>}
                . qq{<td>} . esc($d->{comment}) . qq{</td>}
                . qq{</tr>\n};
        }
        print qq{</table>\n};
        print qq{<p class="no-match" id="dev-no-match" style="display:none;">}
            . qq{No devices match your filter.</p>\n};
        print qq{</div>\n};   # .dev-main

        # Statistics panel (upper-right).
        print qq{<div class="dev-stats">\n};
        print qq{<h2>Statistics</h2>\n};
        print qq{<p><strong>} . esc($total) . qq{</strong> device}
            . ($total == 1 ? '' : 's') . qq{ total.</p>\n};
        print qq{<p><strong id="dev-filtered-count">} . esc($total) . qq{</strong> }
            . qq{device<span id="dev-filtered-plural">} . ($total == 1 ? '' : 's') . qq{</span> filtered.</p>\n};
        print qq{<table class="list dev-stats-table">\n}
            . qq{<tr><th>Model</th><th>Devices</th></tr>\n};
        for my $m (@models) {
            print qq{<tr><td>} . esc($m) . qq{</td>}
                . qq{<td>} . esc($by_model{$m}) . qq{</td></tr>\n};
        }
        print qq{</table>\n};
        # Feedback: how long reading + parsing the device table took. Shown in
        # the same small font as the page footer / copyright line. Under 1s
        # it's shown in milliseconds, otherwise in seconds.
        my $load_str = $load_secs < 1
            ? sprintf('%dms', int($load_secs * 1000 + 0.5))
            : sprintf('%.2fs', $load_secs);
        print qq{<p class="dev-loadtime">Device table load time: }
            . esc($load_str) . qq{</p>\n};
        print qq{</div>\n};   # .dev-stats

        print qq{</div>\n};   # .dev-layout

        print device_filter_script();
        print top_bottom_nav();
    }
    print page_foot();
}

# Client-side substring filter for the device list. Runs entirely in the
# browser against the already-rendered rows -- no round trip to the server
# or to fetchconfig.pl, since the full device list is already on the page.
# Matching is case-insensitive and matches anywhere in the Device-ID text.
sub device_filter_script {
    return <<'JS';
<script>
(function () {
    var modelInput   = document.getElementById('model-filter');   // <select>
    var devInput     = document.getElementById('dev-filter');
    var hostInput    = document.getElementById('host-filter');
    var commentInput = document.getElementById('comment-filter');
    var clearBtn     = document.getElementById('clear-filter');
    var pageSizeSel  = document.getElementById('dev-page-size');
    var table        = document.getElementById('dev-table');
    var noMatch      = document.getElementById('dev-no-match');
    var pager        = document.getElementById('devlist-pager');
    var pagerFirst   = document.getElementById('devlist-first');
    var pagerPrev    = document.getElementById('devlist-prev');
    var pagerNext    = document.getElementById('devlist-next');
    var pagerLast    = document.getElementById('devlist-last');
    var pagerInfo    = document.getElementById('devlist-pageinfo');
    if (!table) return;
    var rows = Array.prototype.slice.call(table.querySelectorAll('tr')).slice(1); // skip header
    var container = rows.length ? rows[0].parentNode : null;

    var sort = { key: 'dev', dir: 'asc' };
    var page = 0;

    // --- cookie persistence (model, device, host, comment, page size) ----
    var COOKIE = 'fcweb_devfilter';
    function setCookie(v) {
        document.cookie = COOKIE + '=' + encodeURIComponent(v) + ';path=/;max-age=31536000';
    }
    function getCookie() {
        var m = document.cookie.match(/(?:^|;\s*)fcweb_devfilter=([^;]*)/);
        return m ? decodeURIComponent(m[1]) : '';
    }
    function saveFilters() {
        var mv = modelInput ? modelInput.value : '';
        var dv = devInput ? devInput.value : '';
        var hv = hostInput ? hostInput.value : '';
        var cv = commentInput ? commentInput.value : '';
        var ps = pageSizeSel ? pageSizeSel.value : '100';
        setCookie([mv, dv, hv, cv, ps].map(encodeURIComponent).join('|'));
    }
    function restoreFilters() {
        var raw = getCookie();
        if (!raw) return;
        var p = raw.split('|');
        var mv = p[0] ? decodeURIComponent(p[0]) : '';
        var dv = p[1] ? decodeURIComponent(p[1]) : '';
        var hv = p[2] ? decodeURIComponent(p[2]) : '';
        var cv = p[3] ? decodeURIComponent(p[3]) : '';
        var ps = p[4] ? decodeURIComponent(p[4]) : '';
        if (modelInput && mv) {
            for (var i = 0; i < modelInput.options.length; i++) {
                if (modelInput.options[i].value === mv) { modelInput.value = mv; break; }
            }
        }
        if (devInput) devInput.value = dv;
        if (hostInput) hostInput.value = hv;
        if (commentInput) commentInput.value = cv;
        if (pageSizeSel && ps !== '') {
            for (var j = 0; j < pageSizeSel.options.length; j++) {
                if (pageSizeSel.options[j].value === ps) { pageSizeSel.value = ps; break; }
            }
        }
    }

    // A row matches the current filter? Model = exact (empty = all);
    // device, host & comment = case-insensitive substring. Combined with AND.
    function matches(row) {
        var mq = modelInput ? modelInput.value : '';
        var dq = devInput ? devInput.value.trim().toLowerCase() : '';
        var hq = hostInput ? hostInput.value.trim().toLowerCase() : '';
        var cq = commentInput ? commentInput.value.trim().toLowerCase() : '';
        var model   = row.getAttribute('data-model') || '';
        var dev     = row.getAttribute('data-dev') || '';
        var host    = row.getAttribute('data-host') || '';
        var comment = row.getAttribute('data-comment') || '';
        return (mq === '' || model === mq) &&
               (dq === '' || dev.indexOf(dq) !== -1) &&
               (hq === '' || host.indexOf(hq) !== -1) &&
               (cq === '' || comment.indexOf(cq) !== -1);
    }

    // Single source of truth: filter, then show only the current page of the
    // matching rows (in current sort order). Also updates the pager and the
    // "devices filtered" statistics line.
    function render() {
        var matched = rows.filter(matches);
        var total = matched.length;
        var size = pageSizeSel ? parseInt(pageSizeSel.value, 10) : 100;
        if (isNaN(size)) size = 100;             // safety
        var allOnePage = (size === 0);           // "All"
        var pages = allOnePage ? 1 : Math.max(1, Math.ceil(total / size));
        if (page >= pages) page = pages - 1;
        if (page < 0) page = 0;
        var start = allOnePage ? 0 : page * size;
        var end   = allOnePage ? total : start + size;

        // Hide everything, then show the current page's slice of matches.
        rows.forEach(function (r) { r.style.display = 'none'; });
        for (var i = start; i < end && i < total; i++) matched[i].style.display = '';

        if (noMatch) noMatch.style.display = (total === 0) ? '' : 'none';

        // Pager: shown only when there's more than one page.
        if (pager) {
            pager.style.display = (pages > 1) ? '' : 'none';
            if (pagerInfo) {
                pagerInfo.textContent = 'Page ' + (page + 1) + ' of ' + pages +
                    ' (' + total + ' match' + (total === 1 ? '' : 'es') + ')';
            }
            if (pagerFirst) pagerFirst.disabled = (page <= 0);
            if (pagerPrev)  pagerPrev.disabled  = (page <= 0);
            if (pagerNext)  pagerNext.disabled  = (page >= pages - 1);
            if (pagerLast)  pagerLast.disabled  = (page >= pages - 1);
            // Remember the last page so the Last button can jump to it.
            pager.setAttribute('data-pages', pages);
        }

        // Statistics "devices filtered" line = total matched (all pages).
        var fc = document.getElementById('dev-filtered-count');
        if (fc) fc.textContent = total;
        var fp = document.getElementById('dev-filtered-plural');
        if (fp) fp.textContent = (total === 1) ? '' : 's';
    }

    // Changing a filter resets to page 1; changing page size keeps you near
    // the top too.
    function onFilterChange() { page = 0; render(); saveFilters(); }
    if (modelInput)   modelInput.addEventListener('change', onFilterChange);
    if (devInput)     devInput.addEventListener('input', onFilterChange);
    if (hostInput)    hostInput.addEventListener('input', onFilterChange);
    if (commentInput) commentInput.addEventListener('input', onFilterChange);
    if (pageSizeSel)  pageSizeSel.addEventListener('change', onFilterChange);
    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            if (modelInput)   modelInput.value = '';
            if (devInput)     devInput.value = '';
            if (hostInput)    hostInput.value = '';
            if (commentInput) commentInput.value = '';
            page = 0;
            render();
            saveFilters();
            if (devInput) devInput.focus();
        });
    }
    if (pagerFirst) pagerFirst.addEventListener('click', function () { page = 0; render(); });
    if (pagerPrev) pagerPrev.addEventListener('click', function () { page--; render(); });
    if (pagerNext) pagerNext.addEventListener('click', function () { page++; render(); });
    // A very large page number; render() clamps it to the last valid page.
    if (pagerLast) pagerLast.addEventListener('click', function () { page = 1e9; render(); });

    // --- Column sorting (Model / Device-ID / Hostname) -------------------
    var headers = Array.prototype.slice.call(table.querySelectorAll('th.sortable'));
    function sortBy(key, dir) {
        // The Hostname column sorts on data-host-key (server-computed so
        // IPv4 addresses order numerically before alphabetical hostnames),
        // not on the displayed data-host value.
        var attr = (key === 'host') ? 'data-host-key' : ('data-' + key);
        var sorted = rows.slice().sort(function (a, b) {
            var av = a.getAttribute(attr) || '';
            var bv = b.getAttribute(attr) || '';
            var c = av < bv ? -1 : (av > bv ? 1 : 0);
            return dir === 'asc' ? c : -c;
        });
        if (container) sorted.forEach(function (r) { container.appendChild(r); });
        rows = sorted;
        headers.forEach(function (th) {
            var ind = th.querySelector('.sort-ind');
            if (!ind) return;
            ind.textContent = (th.getAttribute('data-key') === key)
                ? (dir === 'asc' ? ' \u25B2' : ' \u25BC') : '';
        });
        render();   // re-page after reordering
    }
    headers.forEach(function (th) {
        th.addEventListener('click', function () {
            var key = th.getAttribute('data-key');
            if (sort.key === key) { sort.dir = (sort.dir === 'asc') ? 'desc' : 'asc'; }
            else { sort.key = key; sort.dir = 'asc'; }
            page = 0;
            sortBy(sort.key, sort.dir);
        });
    });

    restoreFilters();
    sortBy(sort.key, sort.dir);   // initial sort + first render (calls render())
})();
</script>
JS
}

sub show_status_page {
    my ($user) = @_;

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    print page_head('Status', $user, 'full');
    print qq{<h1>Status</h1>\n};

    my $t0 = [Time::HiRes::gettimeofday()];
    my ($rows, $err) = read_all_status();
    my $load_secs = Time::HiRes::tv_interval($t0);

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
        print page_foot();
        return;
    }
    if (!@$rows) {
        print qq{<p>No devices found in the device table.</p>\n};
        print page_foot();
        return;
    }

    # Filter row: State + Changed dropdowns, Clear, and Per-page selector.
    print qq{<div class="dev-filter-row">\n};
    print qq{<label class="filter-label">State }
        . qq{<select id="status-state-filter" class="filter-select">}
        . qq{<option value="">All states</option>}
        . qq{<option value="success">success</option>}
        . qq{<option value="failed">failed</option>}
        . qq{<option value="skipped">skipped</option>}
        . qq{<option value="n/a">N/A</option>}
        . qq{</select></label>\n};
    print qq{<label class="filter-label">Changed }
        . qq{<select id="status-changed-filter" class="filter-select">}
        . qq{<option value="">All changed</option>}
        . qq{<option value="unchanged">unchanged</option>}
        . qq{<option value="changed">changed</option>}
        . qq{<option value="forced">forced</option>}
        . qq{<option value="unknown">unknown</option>}
        . qq{<option value="n/a">N/A</option>}
        . qq{</select></label>\n};
    print qq{<button type="button" class="btn btn-small" id="status-clear">Clear filter</button>\n};
    print qq{<label class="page-size-label">Per page }
        . qq{<select id="status-page-size" class="filter-select">}
        . qq{<option value="0">All</option>}
        . qq{<option value="10">10</option>}
        . qq{<option value="25">25</option>}
        . qq{<option value="50">50</option>}
        . qq{<option value="100" selected>100</option>}
        . qq{</select></label>\n};
    print qq{</div>\n};

    # Pager
    print qq{<div id="status-pager" class="dev-pager" style="display:none;">}
        . qq{<button type="button" class="btn btn-small" id="status-first">&laquo; First</button>}
        . qq{<button type="button" class="btn btn-small" id="status-prev">&larr; Prev</button>}
        . qq{<span id="status-pageinfo" class="pageinfo"></span>}
        . qq{<button type="button" class="btn btn-small" id="status-next">Next &rarr;</button>}
        . qq{<button type="button" class="btn btn-small" id="status-last">Last &raquo;</button>}
        . qq{</div>\n};

    print qq{<table class="list" id="status-table">\n}
        . qq{<tr>}
        . qq{<th class="sortable" data-key="dev">Device-ID<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="sdate">Start Date<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="stime">Start Time<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="edate">End Date<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="etime">End Time<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="dur">Duration<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="state">State<span class="sort-ind"></span></th>}
        . qq{<th class="sortable" data-key="changed">Changed<span class="sort-ind"></span></th>}
        . qq{</tr>\n};

    for my $r (@$rows) {
        my $dev  = $r->{id};
        my $info = $r->{info};
        # Cells: N/A when no status file (or a field is missing).
        my $sdate = ($info && defined $info->{start_date}) ? $info->{start_date} : 'N/A';
        my $stime = ($info && defined $info->{start_time}) ? $info->{start_time} : 'N/A';
        my $edate = ($info && defined $info->{end_date})   ? $info->{end_date}   : 'N/A';
        my $etime = ($info && defined $info->{end_time})   ? $info->{end_time}   : 'N/A';
        my $dur   = ($info && defined $info->{duration})   ? $info->{duration} . 's' : 'N/A';
        my $state = ($info && defined $info->{state})      ? $info->{state}   : 'N/A';
        my $chg   = ($info && defined $info->{changed})    ? $info->{changed} : 'N/A';

        # Filter keys: lowercased; "n/a" when the value is absent.
        my $state_key = ($info && defined $info->{state})   ? lc($info->{state})   : 'n/a';
        my $chg_key   = ($info && defined $info->{changed}) ? lc($info->{changed}) : 'n/a';
        # Duration sort key: numeric seconds (N/A sorts as -1 so it groups first ascending).
        my $dur_key   = ($info && defined $info->{duration}) ? $info->{duration} : -1;

        my $state_cls = 'st-' . $state_key;   # st-success/st-failed/st-skipped/st-n/a
        $state_cls =~ s{/}{}g;                # 'n/a' -> 'na' for a valid class
        my $chg_cls   = 'ch-' . $chg_key;
        $chg_cls =~ s{/}{}g;

        # Device link carries from=status so the backups page's breadcrumb
        # returns here instead of to Devices.
        my $link = script_url() . '?dev=' . CGI::escape($dev) . '&from=status';

        print qq{<tr }
            . qq{data-dev="}    . esc(lc $dev)   . qq{" }
            . qq{data-sdate="}  . esc($sdate)    . qq{" }
            . qq{data-stime="}  . esc($stime)    . qq{" }
            . qq{data-edate="}  . esc($edate)    . qq{" }
            . qq{data-etime="}  . esc($etime)    . qq{" }
            . qq{data-dur="}    . esc($dur_key)  . qq{" }
            . qq{data-state="}  . esc($state_key). qq{" }
            . qq{data-changed="}. esc($chg_key)  . qq{">}
            . qq{<td><a href="} . esc($link) . qq{">} . esc($dev) . qq{</a></td>}
            . qq{<td>} . esc($sdate) . qq{</td>}
            . qq{<td>} . esc($stime) . qq{</td>}
            . qq{<td>} . esc($edate) . qq{</td>}
            . qq{<td>} . esc($etime) . qq{</td>}
            . qq{<td>} . esc($dur) . qq{</td>}
            . qq{<td><span class="} . esc($state_cls) . qq{">} . esc($state) . qq{</span></td>}
            . qq{<td><span class="} . esc($chg_cls)   . qq{">} . esc($chg)   . qq{</span></td>}
            . qq{</tr>\n};
    }
    print qq{</table>\n};
    print qq{<p id="status-no-match" class="muted" style="display:none;">No devices match the current filter.</p>\n};

    my $load_str = $load_secs < 1
        ? sprintf('%dms', int($load_secs * 1000 + 0.5))
        : sprintf('%.2fs', $load_secs);
    print qq{<p class="dev-loadtime">Status table load time: } . esc($load_str) . qq{</p>\n};

    print status_page_script();
    print top_bottom_nav();
    print page_foot();
}

# Client-side filter/sort/paginate for the Status table. Self-contained,
# namespaced 'status-*'. Mirrors the device-list behaviour.
sub status_page_script {
    return <<'JS';
<script>
(function () {
  var table = document.getElementById('status-table');
  if (!table) return;
  var stateSel = document.getElementById('status-state-filter');
  var chgSel   = document.getElementById('status-changed-filter');
  var clearBtn = document.getElementById('status-clear');
  var sizeSel  = document.getElementById('status-page-size');
  var noMatch  = document.getElementById('status-no-match');
  var pager    = document.getElementById('status-pager');
  var pFirst   = document.getElementById('status-first');
  var pPrev    = document.getElementById('status-prev');
  var pNext    = document.getElementById('status-next');
  var pLast    = document.getElementById('status-last');
  var pInfo    = document.getElementById('status-pageinfo');

  var rows = Array.prototype.slice.call(table.querySelectorAll('tr')).filter(function (r) {
    return !r.querySelector('th');
  });
  var page = 0;

  // cookie persistence: state|changed|pagesize
  var COOKIE = 'fcweb_statusfilter';
  function setCookie(v){ document.cookie = COOKIE+'='+encodeURIComponent(v)+';path=/;max-age=31536000'; }
  function getCookie(){ var m=document.cookie.match(/(?:^|;\s*)fcweb_statusfilter=([^;]*)/); return m?decodeURIComponent(m[1]):''; }
  function save(){
    setCookie([ stateSel?stateSel.value:'', chgSel?chgSel.value:'', sizeSel?sizeSel.value:'100' ]
      .map(encodeURIComponent).join('|'));
  }
  function restore(){
    var raw=getCookie(); if(!raw) return;
    var p=raw.split('|');
    function setSel(sel,val){ if(!sel) return; for(var i=0;i<sel.options.length;i++){ if(sel.options[i].value===val){sel.value=val;return;} } }
    setSel(stateSel, p[0]?decodeURIComponent(p[0]):'');
    setSel(chgSel,   p[1]?decodeURIComponent(p[1]):'');
    setSel(sizeSel,  p[2]?decodeURIComponent(p[2]):'');
  }

  function matches(row){
    var sq = stateSel ? stateSel.value : '';
    var cq = chgSel ? chgSel.value : '';
    var st = row.getAttribute('data-state') || '';
    var ch = row.getAttribute('data-changed') || '';
    return (sq==='' || st===sq) && (cq==='' || ch===cq);
  }

  function esc(){}
  function render(){
    var matched = rows.filter(matches);
    var total = matched.length;
    var size = sizeSel ? parseInt(sizeSel.value,10) : 100;
    var allOne = (!size || size<=0);
    var pages = allOne ? 1 : Math.max(1, Math.ceil(total/size));
    if (page>=pages) page=pages-1;
    if (page<0) page=0;
    var start = allOne?0:page*size;
    var end   = allOne?total:start+size;
    rows.forEach(function(r){ r.style.display='none'; });
    for (var i=start;i<end && i<total;i++) matched[i].style.display='';
    if (noMatch) noMatch.style.display = total===0 ? '' : 'none';
    if (pager) {
      pager.style.display = pages>1 ? '' : 'none';
      if (pInfo) pInfo.textContent = 'Page '+(page+1)+' of '+pages+' ('+total+' device'+(total===1?'':'s')+')';
      if (pFirst) pFirst.disabled = page<=0;
      if (pPrev)  pPrev.disabled  = page<=0;
      if (pNext)  pNext.disabled  = page>=pages-1;
      if (pLast)  pLast.disabled  = page>=pages-1;
    }
  }

  function onFilter(){ page=0; render(); save(); }
  if (stateSel) stateSel.addEventListener('change', onFilter);
  if (chgSel)   chgSel.addEventListener('change', onFilter);
  if (sizeSel)  sizeSel.addEventListener('change', onFilter);
  if (clearBtn) clearBtn.addEventListener('click', function(){
    if (stateSel) stateSel.value='';
    if (chgSel)   chgSel.value='';
    page=0; render(); save();
  });
  if (pFirst) pFirst.addEventListener('click', function(){ page=0; render(); });
  if (pPrev)  pPrev.addEventListener('click', function(){ page--; render(); });
  if (pNext)  pNext.addEventListener('click', function(){ page++; render(); });
  if (pLast)  pLast.addEventListener('click', function(){ page=1e9; render(); });

  // Column sorting
  var headers = Array.prototype.slice.call(table.querySelectorAll('th.sortable'));
  function sortBy(key, dir){
    var numeric = (key==='dur');
    var sorted = rows.slice().sort(function(a,b){
      var av=a.getAttribute('data-'+key)||'', bv=b.getAttribute('data-'+key)||'';
      var c;
      if (numeric){ c = (parseFloat(av)||0) - (parseFloat(bv)||0); }
      else { c = av<bv?-1:(av>bv?1:0); }
      return dir==='asc'?c:-c;
    });
    var tb = table.tBodies[0] || table;
    sorted.forEach(function(r){ tb.appendChild(r); });
  }
  headers.forEach(function(h){
    h.addEventListener('click', function(){
      var key=h.getAttribute('data-key');
      var cur=h.getAttribute('data-dir')==='asc'?'desc':'asc';
      headers.forEach(function(o){ o.removeAttribute('data-dir'); var s=o.querySelector('.sort-ind'); if(s)s.textContent=''; });
      h.setAttribute('data-dir',cur);
      var ind=h.querySelector('.sort-ind'); if(ind) ind.textContent = cur==='asc'?' \u25B2':' \u25BC';
      sortBy(key,cur);
      render();
    });
  });

  restore();
  render();
})();
</script>
JS
}

sub show_backup_list {
    my ($user, $dev) = @_;

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev)) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id.</p>\n};
        print page_foot();
        return;
    }

    my ($backups, $err) = list_backups($dev);
    my $show_table = (!$err && @$backups);

    # These web-GUI models store opaque binary backups; a line diff is
    # possible but not meaningful, so the Compare / Side by Side actions (and
    # the row checkboxes) are hidden for them.
    my $model = device_model($dev);
    my $is_tplink = is_web_binary_model($model);
    my $show_compare = $show_table && !$is_tplink;

    print page_head("Backups: $dev", $user, 'full');
    # Breadcrumb: return to the Status page when we arrived from there
    # (?from=status), otherwise to the Devices list.
    my $from = $cgi->param('from') // '';
    my ($crumb_url, $crumb_label) = ($from eq 'status')
        ? (script_url() . '?action=status', '&larr; Status')
        : (script_url(),                    '&larr; Devices');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc($crumb_url) . qq{">$crumb_label</a></p>\n};
    print qq{<h1>Backups for } . esc($dev) . qq{</h1>\n};

    print qq{<div class="action-row">\n};
    print $cgi->start_form(-method => 'POST', -action => script_url(),
        -id => 'backup-now-form');
    print qq{<input type="hidden" name="action" value="backup_now">\n};
    print qq{<input type="hidden" name="dev" value="} . esc($dev) . qq{">\n};
    print csrf_field();
    print qq{<button type="submit" class="btn">Backup now</button>\n};
    print $cgi->end_form;
    if ($show_compare) {
        # Lives outside the compare-form markup below, but the HTML5
        # form="" attribute still submits it as if it were nested inside
        # -- lets it sit next to Backup Now at the top instead of after
        # the table.
        print qq{<button type="submit" form="compare-form" name="action" value="compare" class="btn">Compare selected</button>\n};
        print qq{<button type="submit" form="compare-form" name="action" value="sidebyside" class="btn">Side by side selected</button>\n};
    }
    if ($show_table) {
        # Read-only disk check (fetchconfig.pl -z): a plain GET link like the
        # compare actions. Only meaningful when backups exist, so it's shown
        # alongside them (a device with no backups yet has nothing to check).
        print qq{<a class="btn" href="} . esc(script_url() . '?action=checkempty&dev=' . CGI::escape($dev))
            . qq{">Check for empty backups</a>\n};
        # Read-only check that this device's backups all share one extension.
        print qq{<a class="btn" href="} . esc(script_url() . '?action=checksuffix&dev=' . CGI::escape($dev))
            . qq{">Check backup suffixes</a>\n};
        # Download the newest backup's configuration as a file.
        print qq{<a class="btn" href="} . esc(script_url() . '?action=download_latest&dev=' . CGI::escape($dev))
            . qq{">Download latest configuration</a>\n};
    }
    print qq{</div>\n};

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } elsif (!@$backups) {
        print qq{<p>No configuration backups are available for this device yet. }
            . qq{Use <strong>Backup now</strong> above to take an initial backup.</p>\n};
    } else {
        if ($show_compare) {
            print qq{<p>Tick two backups, then press Compare selected (unified diff) or Side by side selected.</p>\n};
            # GET form: use the urlencoded enctype explicitly. CGI.pm's
            # start_form otherwise defaults to multipart/form-data, which is
            # invalid with method=GET -- Firefox warns and drops it. This is
            # the correct enctype for a GET submission.
            print $cgi->start_form(-method => 'GET', -action => script_url(),
                -enctype => 'application/x-www-form-urlencoded', -id => 'compare-form');
            print qq{<input type="hidden" name="dev" value="} . esc($dev) . qq{">\n};
        }
        my $chk_th = $show_compare ? qq{<th></th>} : '';
        print qq{<table class="list">\n<tr>$chk_th<th>#</th><th>Date</th><th>Time</th><th>Size</th><th>Path</th></tr>\n};
        for my $b (@$backups) {
            my $link = script_url() . '?dev=' . CGI::escape($dev) . '&idx=' . CGI::escape($b->{idx});
            print qq{<tr>};
            print qq{<td><input type="checkbox" class="cmp-sel" name="sel" value="}
                . esc($b->{idx}) . qq{"></td>} if $show_compare;
            print qq{<td><a href="} . esc($link) . qq{">}
                . esc($b->{idx}) . qq{</a></td>};
            print qq{<td>} . esc($b->{date}) . qq{</td>};
            print qq{<td>} . esc($b->{time}) . qq{</td>};
            print qq{<td>} . esc($b->{size}) . qq{</td>};
            print qq{<td>} . esc($b->{path}) . qq{</td></tr>\n};
        }
        print qq{</table>\n};
        if ($show_compare) {
            print $cgi->end_form;
            print <<'JS';
<script>
document.addEventListener('change', function (e) {
    if (!e.target.classList || !e.target.classList.contains('cmp-sel')) return;
    var checked = document.querySelectorAll('.cmp-sel:checked');
    if (checked.length > 2) { e.target.checked = false; }
});
</script>
JS
        }
    }

    # Backup Now feedback: a full-screen overlay with a spinner and a live
    # runtime counter, shown while the (blocking) backup request is in flight.
    # fcBackupNowStart() runs the confirm, and on OK reveals the overlay and
    # starts the timer, then returns true so the form submits normally; the
    # overlay stays until the response page replaces it.
    # Backup Now feedback overlay. If a status file exists (fetchconfig
    # >= 9.52), show the last run's duration/state/changed between the live
    # counter and the patience message.
    my $st = device_status_info($dev);
    my $status_html = '';
    if ($st) {
        $status_html .= qq{    <div class="backup-laststats">\n};
        if (defined $st->{duration}) {
            $status_html .= qq{      <div>Last runtime: } . esc($st->{duration}) . qq{s</div>\n};
        }
        if (defined $st->{state}) {
            $status_html .= qq{      <div>Last backup state: <span class="st-}
                . esc(lc $st->{state}) . qq{">} . esc($st->{state}) . qq{</span></div>\n};
        }
        if (defined $st->{changed}) {
            $status_html .= qq{      <div>Last backup changed: <span class="ch-}
                . esc(lc $st->{changed}) . qq{">} . esc($st->{changed}) . qq{</span></div>\n};
        }
        $status_html .= qq{    </div>\n};
    }

    print <<'JS2a';
<div id="backup-overlay" style="display:none;">
  <div class="backup-overlay-box">
    <div class="backup-spinner" aria-hidden="true"></div>
    <div class="backup-elapsed"><span id="backup-elapsed-n">0</span> s</div>
JS2a
    print $status_html;
    print <<'JS2';
    <div id="backup-patience" class="backup-patience" style="display:none;">
      Backing up a device can take a while &mdash; please be patient.
    </div>
  </div>
</div>
<script>
(function () {
  var form = document.getElementById('backup-now-form');
  if (!form) return;
  var ov   = document.getElementById('backup-overlay');
  var nEl  = document.getElementById('backup-elapsed-n');
  var pat  = document.getElementById('backup-patience');
  var devInput = form.querySelector('input[name="dev"]');
  var dev = devInput ? devInput.value : '';

  form.addEventListener('submit', function (e) {
    // Always intercept; the custom confirm is asynchronous.
    e.preventDefault();
    var proceed = function () {
      // Without fetch, fall back to a normal (navigating) submit.
      if (!ov || typeof window.fetch !== 'function') { form.submit(); return; }
      // Handle the request ourselves so THIS page (with the overlay) stays on
      // screen. A normal submit navigates away immediately and the browser
      // stops painting the just-shown overlay -- so we POST via fetch(),
      // keeping the spinner + timer visible until the reply arrives.
      ov.style.display = 'flex';
      var start = Date.now();
      setInterval(function () {
        var s = Math.floor((Date.now() - start) / 1000);
        if (nEl) nEl.textContent = s;
        if (pat && s >= 10) pat.style.display = '';
      }, 250);

      fetch(form.getAttribute('action'), {
        method: 'POST',
        body: new FormData(form),
        credentials: 'same-origin'
      }).then(function (resp) {
        return resp.text();
      }).then(function (html) {
        document.open();
        document.write(html);
        document.close();
      }).catch(function () {
        ov.style.display = 'none';
        alert('The backup request could not be completed (network error). Please try again.');
      });
    };
    if (window.fcConfirm) window.fcConfirm('Run a live backup for ' + dev + ' now?', proceed);
    else if (window.confirm('Run a live backup for ' + dev + ' now?')) proceed();
  });
})();
</script>
JS2

    print page_foot();
}

# =============================================================================
# Config syntax highlighting (backup content view only)
# =============================================================================
#
# Extensible by design: a registry maps a fetchconfig model name to a
# highlighter coderef. highlight_config() looks up the device's model and,
# if a highlighter is registered, returns HTML with the config wrapped in
# coloured <span>s; otherwise it returns undef and the caller falls back to
# a plain esc()'d <pre>. To add another model later, write a
# highlight_<model>() sub and add one line to %SYNTAX_HIGHLIGHTERS.
#
# IMPORTANT: highlighters receive the RAW config text and must HTML-escape
# every character they emit (via esc(), which also masks pass=/enable=
# secrets). They run instead of the normal esc() on the whole block, so
# forgetting to escape a token would be an injection bug -- the helpers
# below (hl() / esc()) do the escaping, and highlighters must only ever emit
# text through them.

my %SYNTAX_HIGHLIGHTERS;   # model => coderef($raw_content) -> html

# Wrap already-escaped text in a highlight span of the given class.
sub hl {
    my ($class, $escaped_text) = @_;
    return qq{<span class="hl-$class">$escaped_text</span>};
}

# Return highlighted HTML for $content given the device $model, or undef if
# no highlighter is registered for that model.
sub highlight_config {
    my ($model, $content) = @_;
    return undef unless defined $model;
    my $fn = $SYNTAX_HIGHLIGHTERS{$model};
    return undef unless $fn;
    return $fn->($content);
}

# --- Cisco IOS highlighter (cisco-ios, cisco-ios-ssh) --------------------
#
# A lightweight, line-oriented highlighter -- not a full IOS grammar. It
# colours: comment/`!` lines, a leading command keyword, interface-type
# identifiers, IPv4 addresses, quoted strings, and bare numbers. Everything
# is escaped via esc() first (which also masks secrets), then coloured, so
# masked values like pass=?***? stay masked and nothing can be injected.
sub highlight_cisco_ios {
    my ($content) = @_;
    my @out;
    # Track free-form blocks whose body should NOT be token-coloured:
    #   * certificate / key hex dumps  ("certificate ..." ... "quit")
    #   * banners ("banner <type> ^C" ... closing "^C")
    # Inside either, per-token colouring (numbers in addresses, phone
    # numbers, hex, etc.) looks wrong, so the body is emitted escaped-only.
    my $in_cert   = 0;
    my $in_banner = 0;

    for my $line (split /\n/, $content, -1) {

        # --- inside a banner: body is free text until the closing delimiter.
        # The banner delimiter is whatever followed "banner <type>" -- almost
        # always ^C (either the two literal chars "^C" or a real 0x03). We
        # end the banner on a line that contains that delimiter. The line
        # carrying the closing delimiter is still emitted escaped-only (it's
        # banner text / the bare delimiter, not a command).
        if ($in_banner) {
            push @out, esc($line);
            $in_banner = 0 if $line =~ /\^C/ || $line =~ /\x03/;
            next;
        }

        # --- inside a certificate hex dump.
        if ($in_cert) {
            if ($line =~ /^\s*quit\s*$/) {
                $in_cert = 0;
                push @out, _hl_ios_line($line);
            } elsif ($line =~ /^\s*!/ || $line =~ /^\s*$/) {
                $in_cert = 0;
                push @out, _hl_ios_line($line);
            } else {
                push @out, esc($line);   # hex-dump body: escape only
            }
            next;
        }

        # --- start of a certificate block.
        if ($line =~ /^\s*certificate\b/) {
            $in_cert = 1;
            push @out, _hl_ios_line($line);
            next;
        }

        # --- start of a banner block: "banner <type> <delim>...". Colour the
        # header line normally. If the whole banner is on one line (a second
        # delimiter present after the first), it's self-contained; otherwise
        # the body follows on later lines until the closing delimiter.
        if ($line =~ /^\s*banner\b/) {
            push @out, _hl_ios_line($line);
            # Count delimiters on the header line: "banner motd ^C text ^C"
            # would be self-contained (2), "banner motd ^C" opens a block (1).
            my $delims = () = ($line =~ /\^C|\x03/g);
            $in_banner = 1 if $delims < 2;
            next;
        }

        push @out, _hl_ios_line($line);
    }
    return join("\n", @out);
}

# Highlight a single IOS line. Works on the RAW line; escapes each piece as
# it is emitted.
sub _hl_ios_line {
    my ($line) = @_;

    # Comment / banner-delimiter lines: whole line muted.
    if ($line =~ /^\s*!/) {
        return hl('comment', esc($line));
    }
    # Blank line.
    return '' if $line =~ /^\s*$/;

    # Split leading indentation, then tokenize the rest into words while
    # keeping the exact whitespace between them (so the layout is preserved).
    my ($indent, $rest) = ($line =~ /^(\s*)(.*)$/s);
    my $html = esc($indent);

    # Tokens: runs of non-space, or runs of space (kept verbatim).
    my @tokens = ($rest =~ /(\S+|\s+)/g);
    my $word_index = 0;   # count of non-space tokens seen so far
    for my $tok (@tokens) {
        if ($tok =~ /^\s+$/) {
            $html .= esc($tok);
            next;
        }
        $html .= _hl_ios_token($tok, $word_index);
        $word_index++;
    }
    return $html;
}

# Colour one IOS word token. $pos is its 0-based position among words on the
# line (the first word is the command keyword).
sub _hl_ios_token {
    my ($tok, $pos) = @_;

    # A double-quoted string (e.g. description "...") -- but tokenizing on
    # whitespace splits quoted strings; we only catch single-token quotes
    # here. Multi-word quoted text still gets per-word colouring, which is
    # acceptable for this lightweight scheme.
    if ($tok =~ /^"[^"]*"$/) {
        return hl('string', esc($tok));
    }
    # IPv4 address or address/mask or CIDR.
    if ($tok =~ m{^\d{1,3}(?:\.\d{1,3}){3}(?:/\d{1,2})?$}) {
        return hl('ip', esc($tok));
    }
    # Interface-type identifier: a Name followed by digits and slashes/dots
    # (GigabitEthernet0/1, FastEthernet0/0.10, Vlan10, Loopback0, Tunnel1).
    if ($tok =~ m{^(?:[A-Za-z]{2,})[0-9]+(?:[/.:][0-9]+)*$}) {
        return hl('iface', esc($tok));
    }
    # A pure number.
    if ($tok =~ /^\d+$/) {
        return hl('num', esc($tok));
    }
    # The first word on a line is the command keyword.
    if ($pos == 0 && $tok =~ /^[A-Za-z][\w-]*$/) {
        return hl('kw', esc($tok));
    }
    # Anything else: escaped, uncoloured.
    return esc($tok);
}

# --- ProCurve highlighter (procurve, procurve-ssh) ----------------------
#
# ProCurve/Aruba running-config. Independent from the IOS highlighter so its
# rules can be tuned separately. Notable syntax: comment lines start with
# ';' (not '!'); quoted strings are common (hostname "...", name "...");
# ports/interfaces are bare tokens like 1/A2, 2/L15, Trk10; blocks close
# with 'exit'. VLAN membership continuation lines (a leading space followed
# by a port list) are left uncoloured. Everything is escaped via esc()
# first (which also masks pass=/enable= secrets).
sub highlight_procurve {
    my ($content) = @_;
    my @out;
    for my $line (split /\n/, $content, -1) {
        push @out, _hl_pc_line($line);
    }
    return join("\n", @out);
}

sub _hl_pc_line {
    my ($line) = @_;
    # Comment line: ';' starts a comment in ProCurve configs.
    return hl('comment', esc($line)) if $line =~ /^\s*;/;
    return '' if $line =~ /^\s*$/;

    # VLAN port-membership continuation lines: a leading space then a run of
    # port tokens/ranges (e.g. " 1/A4,1/I1-1/I8,...") with no command word.
    # Leave these uncoloured -- they're data, not commands.
    if ($line =~ m{^\s+[0-9A-Za-z/,\-]+$} && $line =~ m{[/,\-]}) {
        return esc($line);
    }

    my ($indent, $rest) = ($line =~ /^(\s*)(.*)$/s);
    my $html = esc($indent);
    my @tokens = ($rest =~ /(\"[^\"]*\"|\S+|\s+)/g);
    my $wi = 0;
    for my $tok (@tokens) {
        if ($tok =~ /^\s+$/) { $html .= esc($tok); next; }
        $html .= _hl_pc_token($tok, $wi);
        $wi++;
    }
    return $html;
}

sub _hl_pc_token {
    my ($tok, $pos) = @_;
    return hl('string', esc($tok)) if $tok =~ /^"[^"]*"$/;                  # quoted string
    return hl('ip', esc($tok)) if $tok =~ m{^\d{1,3}(?:\.\d{1,3}){3}(?:/\d{1,2})?$};
    # ProCurve port/interface token: 1/A2, 2/L15, A1, Trk10, and ranges.
    return hl('iface', esc($tok)) if $tok =~ m{^(?:Trk\d+|\d+/[A-Za-z]?\d+|[A-Za-z]\d+)(?:-\S+)?$};
    return hl('num', esc($tok)) if $tok =~ /^\d+$/;
    # 'no' negation prefix and the leading command word: keyword colour.
    return hl('kw', esc($tok)) if $pos == 0 && $tok =~ /^(?:no|[A-Za-z][\w-]*)$/;
    return esc($tok);
}

# --- Comware highlighter (comware-ssh) -----------------------------------
#
# Comware / H3C running-config. Independent highlighter. Notable syntax:
# '#' lines are section separators/comments; commands may be negated with a
# leading 'undo'; interfaces are GigabitEthernet1/0/1, Ten-GigabitEthernet..,
# Vlan-interface1100, Bridge-Aggregation101; blocks close with 'quit' /
# 'return'. Password material -- "key ... cipher $..." and "password hash
# $..." -- is left as plain escaped text (not tokenised), and the usual
# esc() secret-masking still applies on top.
sub highlight_comware {
    my ($content) = @_;
    my @out;
    for my $line (split /\n/, $content, -1) {
        push @out, _hl_cw_line($line);
    }
    return join("\n", @out);
}

sub _hl_cw_line {
    my ($line) = @_;
    # '#' lines (often a lone '#') are section separators/comments.
    return hl('comment', esc($line)) if $line =~ /^\s*#/;
    return '' if $line =~ /^\s*$/;

    # Lines carrying credential material: show escaped-only (don't colour the
    # hash/cipher blob as tokens). esc() still masks pass=/enable= forms.
    if ($line =~ /\b(?:cipher|hash)\b/ || $line =~ /^\s*password\b/) {
        return esc($line);
    }

    my ($indent, $rest) = ($line =~ /^(\s*)(.*)$/s);
    my $html = esc($indent);
    my @tokens = ($rest =~ /(\S+|\s+)/g);
    my $wi = 0;
    for my $tok (@tokens) {
        if ($tok =~ /^\s+$/) { $html .= esc($tok); next; }
        $html .= _hl_cw_token($tok, $wi);
        $wi++;
    }
    return $html;
}

sub _hl_cw_token {
    my ($tok, $pos) = @_;
    return hl('ip', esc($tok)) if $tok =~ m{^\d{1,3}(?:\.\d{1,3}){3}(?:/\d{1,2})?$};
    # Comware interface identifiers (incl. hyphenated type names).
    return hl('iface', esc($tok))
        if $tok =~ m{^(?:[A-Za-z]+-)*[A-Za-z]{2,}\d+(?:/\d+)*$};
    return hl('num', esc($tok)) if $tok =~ /^\d+$/;
    # 'undo' negation prefix and the leading command word: keyword colour.
    return hl('kw', esc($tok)) if $pos == 0 && $tok =~ /^(?:undo|[A-Za-z][\w-]*)$/;
    return esc($tok);
}

# --- Zyxel highlighter (zyxel) ------------------------------------------
#
# Zyxel switch running-config. Cisco-IOS-like, but with its own quirks, so
# it's a separate highlighter (independently tunable). Notable differences
# from IOS: interface names carry a SPACE before the unit
# ("GigabitEthernet 1/1", "interface vlan 200"), so the type word and the
# "1/1" unit are separate tokens; and credentials appear as
# "username ... password encrypted <blob>". Comment lines start with "!"
# like IOS. Everything is escaped via esc() first (which also masks
# pass=/enable= secrets); a "password ..." line is emitted escaped-only so
# the encrypted blob isn't tokenised.
sub highlight_zyxel {
    my ($content) = @_;
    my @out;
    for my $line (split /\n/, $content, -1) {
        push @out, _hl_zyxel_line($line);
    }
    return join("\n", @out);
}

sub _hl_zyxel_line {
    my ($line) = @_;
    return hl('comment', esc($line)) if $line =~ /^\s*!/;   # ! comment
    return '' if $line =~ /^\s*$/;

    # Credential line: "username <u> ... password [encrypted] <blob>" or a
    # bare "password ...". Colour the leading keyword(s) but leave the rest
    # (the blob) as plain escaped text so it isn't tokenised. esc() still
    # masks pass=/enable= key=value forms elsewhere.
    if ($line =~ /^(\s*)(username\b.*?\bpassword\b|password\b)(\s+encrypted\b)?(\s*)(.*)$/) {
        my ($ind, $kw, $enc, $sp, $rest) = ($1, $2, $3 // '', $4 // '', $5 // '');
        my $h = esc($ind);
        # Colour the first word of $kw as a keyword; rest of $kw plain.
        if ($kw =~ /^(\S+)(.*)$/s) { $h .= hl('kw', esc($1)) . esc($2); }
        else { $h .= esc($kw); }
        $h .= esc($enc) if $enc ne '';
        $h .= esc($sp) . esc($rest);
        return $h;
    }

    my ($indent, $rest) = ($line =~ /^(\s*)(.*)$/s);
    my $html = esc($indent);
    my @tokens = ($rest =~ /(\"[^\"]*\"|\S+|\s+)/g);
    my $wi = 0;
    for my $tok (@tokens) {
        if ($tok =~ /^\s+$/) { $html .= esc($tok); next; }
        $html .= _hl_zyxel_token($tok, $wi);
        $wi++;
    }
    return $html;
}

sub _hl_zyxel_token {
    my ($tok, $pos) = @_;
    return hl('string', esc($tok)) if $tok =~ /^"[^"]*"$/;                  # quoted string
    return hl('ip', esc($tok)) if $tok =~ m{^\d{1,3}(?:\.\d{1,3}){3}(?:/\d{1,2})?$};
    # Zyxel unit token: "1/1", "1/10" (the part after "GigabitEthernet ").
    return hl('iface', esc($tok)) if $tok =~ m{^\d+/\d+$};
    # An interface-type word (GigabitEthernet, FastEthernet, ...).
    return hl('iface', esc($tok)) if $tok =~ /^(?:[A-Za-z]{2,})Ethernet$/;
    return hl('num', esc($tok)) if $tok =~ /^\d+$/;
    # First word on a line (incl. "no") is the command keyword.
    return hl('kw', esc($tok)) if $pos == 0 && $tok =~ /^(?:no|[A-Za-z][\w-]*)$/;
    return esc($tok);
}

# --- Aruba CX highlighter (aruba-cx-ssh) --------------------------------
#
# Aruba AOS-CX running-config. Independent highlighter (AOS-CX is IOS-like
# but has its own quirks). Notable syntax: "!" comment lines (incl.
# "!Version ...", "!export-password:"); a banner whose delimiter is "!"
# ("banner motd !" then the body up to the next "!" line); credential lines
# carrying a "ciphertext <blob>" (from "password ciphertext" / "key
# ciphertext") whose blob must not be tokenised; interfaces named
# "interface 1/1/1", "interface lag 1", "interface vlan 1"; IPv4 addresses
# that may carry a /CIDR suffix; and single-quoted description strings.
# Everything is escaped via esc() first (which also masks pass=/enable=
# secrets).
sub highlight_aruba_cx {
    my ($content) = @_;
    my @out;
    my $in_banner = 0;
    for my $line (split /\n/, $content, -1) {
        if ($in_banner) {
            # Banner body, emitted plain (not tokenised). The banner's
            # delimiter is "!"; AOS-CX puts the message on the line(s) after
            # "banner motd !" and terminates it with a "!" -- usually at the
            # END of the last message line (e.g. "...Werk Hessdorf!"), not on
            # a line of its own. So the banner ends as soon as a body line
            # contains a "!".
            push @out, esc($line);
            $in_banner = 0 if $line =~ /!/;
            next;
        }
        # "banner <type> !" opens a banner whose delimiter is "!". If the
        # header line has a SECOND "!" after the delimiter, the whole banner
        # is on one line and no body follows.
        if ($line =~ /^\s*banner\b\S*\s+\S.*?!/) {
            push @out, _hl_aruba_line($line);
            # Count "!" after the "banner" word: one opens a body; two or
            # more means it's self-contained.
            my $bangs = () = ($line =~ /!/g);
            $in_banner = 1 if $bangs < 2;
            next;
        }
        push @out, _hl_aruba_line($line);
    }
    return join("\n", @out);
}

sub _hl_aruba_line {
    my ($line) = @_;
    return hl('comment', esc($line)) if $line =~ /^\s*!/;   # ! comment / separator
    return '' if $line =~ /^\s*$/;

    # Credential lines: anything with a "ciphertext <blob>" (password/key) --
    # emit escaped-only from the "ciphertext" keyword on, so the blob isn't
    # tokenised. The part before it is still tokenised normally.
    if ($line =~ /^(.*?\bciphertext\b\s*)(\S+)(.*)$/) {
        my ($pre, $blob, $post) = ($1, $2, $3);
        my $h = _hl_aruba_tokens($pre);
        $h .= esc($blob) . esc($post);
        return $h;
    }

    return _hl_aruba_tokens($line);
}

# Tokenise + colour a plain AOS-CX line (no comment/credential special-case).
sub _hl_aruba_tokens {
    my ($text) = @_;
    my ($indent, $rest) = ($text =~ /^(\s*)(.*)$/s);
    my $html = esc($indent);
    # Keep single-quoted strings whole; otherwise split on whitespace.
    my @tokens = ($rest =~ /('[^']*'|\S+|\s+)/g);
    my $wi = 0;
    for my $tok (@tokens) {
        if ($tok =~ /^\s+$/) { $html .= esc($tok); next; }
        $html .= _hl_aruba_token($tok, $wi);
        $wi++;
    }
    return $html;
}

sub _hl_aruba_token {
    my ($tok, $pos) = @_;
    return hl('string', esc($tok)) if $tok =~ /^'[^']*'$/;                  # 'quoted'
    # IPv4, optionally with a /CIDR suffix (172.25.1.97/16, 0.0.0.0/0).
    return hl('ip', esc($tok)) if $tok =~ m{^\d{1,3}(?:\.\d{1,3}){3}(?:/\d{1,2})?$};
    # Port identifier: 1/1/1 (and 1/1/1:2 breakout).
    return hl('iface', esc($tok)) if $tok =~ m{^\d+/\d+/\d+(?::\d+)?$};
    return hl('num', esc($tok)) if $tok =~ /^\d+$/;
    # First word (the command keyword -- incl. "no", "user", "loop-protect",
    # "ntp", "interface", etc.) gets the keyword colour.
    return hl('kw', esc($tok)) if $pos == 0 && $tok =~ /^[A-Za-z][\w-]*$/;
    return esc($tok);
}

# --- Cisco Nexus / NX-OS highlighter (nexus-ssh) ------------------------
#
# NX-OS running-config is Cisco-IOS-family syntax (! comments, "interface
# Ethernet1/1", "hostname", "ip address", "feature", "vlan", "no ...") so the
# per-token IOS rules (_hl_ios_line / _hl_ios_token) apply unchanged. NX-OS
# differs from IOS in two ways this highlighter handles:
#
#   1. Banners use an ARBITRARY delimiter chosen by the operator, e.g.
#      "banner motd ^" ... "^" or "banner exec #" ... "#" -- not IOS's ^C.
#      The delimiter is whatever non-space token follows "banner <type>"; the
#      banner body (often ASCII art) runs until a line containing that
#      delimiter again, and is emitted escaped-only so it isn't token-coloured.
#   2. Secret material sits inline after a keyword rather than in a "key=value"
#      pair: "password 5 <hash>", "key 7 "<hex>"", "auth md5 <hex> priv
#      aes-128 <hex> ...". Those blobs are emitted as strings so the per-token
#      rules don't colour the hex/hash oddly. (Note: like IOS "enable secret 5
#      ...", these space-separated secrets are highlighted but NOT masked --
#      mask_secrets only covers "pass=/enable=/community=" style values.)
sub highlight_nexus {
    my ($content) = @_;
    my @out;
    my $in_banner = 0;
    my $delim;                       # current banner delimiter (literal text)

    for my $line (split /\n/, $content, -1) {

        if ($in_banner) {
            push @out, esc($line);
            $in_banner = 0 if defined $delim && index($line, $delim) >= 0;
            next;
        }

        # Start of a banner: "banner <type> <delim>[ body <delim>]".
        if ($line =~ /^\s*banner\b/) {
            push @out, _hl_nexus_line($line);
            # The delimiter is the last non-space token on the header line.
            if (my ($d) = ($line =~ /^\s*banner\s+\S+\s+(\S+)\s*$/)) {
                $delim = $d;
                # Self-contained banner ("banner x ^ text ^") if the delimiter
                # appears again after its first occurrence on this same line.
                my $after = $line;
                $after =~ s/^\s*banner\s+\S+\s+//;      # drop "banner <type> "
                my $first = index($after, $delim);
                my $rest  = ($first >= 0) ? substr($after, $first + length($delim)) : '';
                $in_banner = (index($rest, $delim) >= 0) ? 0 : 1;
            } else {
                $delim = undef;       # malformed header; don't open a block
            }
            next;
        }

        push @out, _hl_nexus_line($line);
    }
    return join("\n", @out);
}

# Highlight one NX-OS line. Protects inline secret blobs, then defers to the
# shared IOS token colouring for everything else.
sub _hl_nexus_line {
    my ($line) = @_;
    return hl('comment', esc($line)) if $line =~ /^\s*!/;
    return '' if $line =~ /^\s*$/;

    # Inline secret material: colour the keyword(s) then emit the blob as a
    # string, leaving the rest of the line to the IOS tokenizer.
    #   ... password <N> <hash> [role ...]
    #   ... key <N> "<hex>"
    # The pre-secret fragment is coloured with the leading word treated as the
    # command keyword (so "tacacs-server"/"username"/"snmp-server" get the same
    # keyword colour as any other command line).
    if ($line =~ /^(\s*)(.*\b(?:password|passphrase|key)\s+\d+\s+)(\S+)(.*)$/) {
        my ($indent, $pre, $secret, $post) = ($1, $2, $3, $4);
        return esc($indent) . _hl_ios_fragment($pre, 0)
             . hl('string', esc($secret))
             . _hl_ios_fragment($post, 1);
    }
    return _hl_ios_line($line);
}

# Colour a fragment with the IOS per-token rules. $start_pos is the word index
# of the fragment's first word: 0 makes that word the command keyword, 1+ keeps
# it mid-line. Preserves whitespace.
sub _hl_ios_fragment {
    my ($frag, $start_pos) = @_;
    my $html = '';
    my $wi = $start_pos;
    for my $tok ($frag =~ /(\S+|\s+)/g) {
        if ($tok =~ /^\s+$/) { $html .= esc($tok); next; }
        $html .= _hl_ios_token($tok, $wi);
        $wi++;
    }
    return $html;
}

# --- AudioCodes Mediant SBC highlighter (mediant-sbc) -------------------
#
# The Mediant SBC "show running-config" is NOT Cisco IOS syntax. It is
# AudioCodes' own "parameter-value" style:
#   - "#" and "##" start comments (## are section banners).
#   - object blocks open with a header line ("configure data",
#     "sbc routing sbc-routing-policy 0", "srd 0", "sip-interface 0",
#     "interface GigabitEthernet 0/0") and close with "activate" / "exit".
#   - most lines are "param-name value ...", param names are hyphenated
#     (network-source, max-message-length, signature-db-enable).
#   - values are bare words, integers, IPv4 addresses, or "quoted strings".
#   - "no <param>" negates; "enabled"/"disabled" are common values.
#   - credentials appear as "password <obscured-blob> obscured" (already
#     obscured by the device; highlighted as a string, not masked -- same as
#     the space-separated secrets in the IOS/NX-OS highlighters, since
#     mask_secrets only covers key=value syntax).
sub highlight_mediant {
    my ($content) = @_;
    my @out;
    for my $line (split /\n/, $content, -1) {
        # Comments: leading # or ## (with optional indent).
        if ($line =~ /^\s*#/) { push @out, hl('comment', esc($line)); next; }
        if ($line =~ /^\s*$/) { push @out, esc($line); next; }

        # Split into indent + tokens, colour token by token. The first
        # non-"no" word on the line is the parameter / block keyword.
        $line =~ /^(\s*)(.*)$/;
        my ($indent, $rest) = ($1, $2);
        my $html = esc($indent);
        my $wi = 0;                          # word index (skipping whitespace)
        for my $tok ($rest =~ /("[^"]*"|\S+|\s+)/g) {
            if ($tok =~ /^\s+$/)              { $html .= esc($tok); next; }
            if ($tok =~ /^"[^"]*"$/)         { $html .= hl('string', esc($tok)); $wi++; next; }
            if ($tok =~ /^\d+(?:\.\d+){3}$/) { $html .= hl('ip',     esc($tok)); $wi++; next; }
            if ($tok =~ /^-?\d+$/)           { $html .= hl('num',    esc($tok)); $wi++; next; }
            if ($tok =~ /^(?:no|enabled|disabled|activate|exit)$/) {
                                               $html .= hl('kw',     esc($tok)); $wi++; next; }
            # First real word on the line = the parameter / block keyword.
            if ($wi == 0 || ($wi == 1 && $rest =~ /^no\s/)) {
                                               $html .= hl('kw',     esc($tok)); $wi++; next; }
            $html .= esc($tok); $wi++;       # everything else: plain
        }
        push @out, $html;
    }
    return join("\n", @out);
}

# --- fetchconfig generic-template highlighter -------------------------------
#
# Colours the state-machine template grammar (see README.template_engine.md):
#   - "#" comments (but NOT inside a /regex/ or a "..."/'...' string)
#   - directives (transport, banner_timeout, capture_from, interrupt, ...)
#   - state grammar (state, expect, send, goto, done, capture_start, ...)
#   - barewords prompt/user/pass/enable
#   - /regex/ patterns, "double"/'single' strings, the -> arrow, numbers
# Line-based; preserves the safety invariant (stripping the spans yields esc()).
sub highlight_template {
    my ($content) = @_;
    # Token -> colour class, by semantic role:
    #   blue  (kw)     : state, reserved state_* entry states, send_match, ->
    #   green (tgreen) : expect
    #   red   (tred)   : send, send_secret, send_nolf, send_match? (send* family)
    #   purple(tpurple): goto, done (control flow)
    #   teal  (tdir)   : directives + max_visits modifier
    #   orange(num)    : capture_start / capture_stop markers + numbers
    #   grey  (comment): nop, comments, the -> arrow
    #   lavender(iface): barewords prompt/user/pass/enable
    #   bold-blue(tstate): user-defined state names (after state/goto)
    my %CLASS = (
        # directives (teal) -- only when first word on the line (see below)
        (map { $_ => 'tdir' } qw(transport banner_timeout fetch_timeout
            fetch_delay prompt_settle max_visits strip_ansi prompt_head
            prompt_tail ssh_extra_opts capture_from skip_first interrupt ignore)),
        # state keywords (blue)
        state => 'kw',
        state_login_ssh => 'kw', state_password_ssh => 'kw',
        state_login_telnet => 'kw', state_password_telnet => 'kw',
        # verbs
        expect => 'tgreen',
        send => 'tred', send_secret => 'tred', send_nolf => 'tred', send_match => 'tred',
        goto => 'tpurple', done => 'tpurple',
        capture_start => 'num', capture_stop => 'num',
        nop => 'comment',
    );
    # Directive words are only coloured as directives at the start of a line;
    # elsewhere (e.g. max_visits as a state modifier) they stay teal too, which
    # is fine. Barewords are operands.
    my %BAREWORD = map { $_ => 1 } qw( prompt user pass enable );
    # Words after these introduce a user-defined state NAME (bold blue).
    my %NAME_INTRO = ( state => 1, goto => 1 );

    my @out;
    for my $line (split /\n/, $content, -1) {
        if ($line =~ /^\s*$/) { push @out, esc($line); next; }
        # Whole-line comment.
        if ($line =~ /^\s*#/) { push @out, hl('comment', esc($line)); next; }

        # Tokenise, keeping /regex/, "..." and '...' as single tokens, and a
        # trailing #comment as its own token. Everything else splits on space.
        my $html = '';
        my $rest = $line;
        my $prev_word;                      # the previous bareword token seen
        # leading indent
        if ($rest =~ s/^(\s+)//) { $html .= esc($1); }

        while (length $rest) {
            if ($rest =~ /^(\s+)/) { $html .= esc($1); $rest = substr($rest, length $1); next; }
            # inline comment to end of line
            if ($rest =~ /^#/) { $html .= hl('comment', esc($rest)); $rest = ''; last; }
            # /regex/  (allow escaped slashes)
            if ($rest =~ m{^(/(?:\\.|[^/\\])*/)}) {
                $html .= hl('string', esc($1)); $rest = substr($rest, length $1); $prev_word = undef; next;
            }
            # "double" or 'single' quoted string
            if ($rest =~ /^("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')/) {
                $html .= hl('string', esc($1)); $rest = substr($rest, length $1); $prev_word = undef; next;
            }
            # the transition arrow -- de-emphasised grey
            if ($rest =~ /^(->)/) { $html .= hl('comment', esc($1)); $rest = substr($rest, 2); $prev_word = undef; next; }
            # a bare word / number
            if ($rest =~ /^(\S+?)(?=\s|->|$|#|\/|["'])/ || $rest =~ /^(\S+)/) {
                my $tok = $1; $rest = substr($rest, length $tok);
                if    ($tok =~ /^-?\d+$/)              { $html .= hl('num', esc($tok)); }
                elsif ($prev_word && $NAME_INTRO{$prev_word}) {
                    # user-defined state name, right after "state" or "goto"
                    $html .= hl('tstate', esc($tok));
                }
                elsif ($CLASS{$tok})                  { $html .= hl($CLASS{$tok}, esc($tok)); }
                elsif ($BAREWORD{$tok})               { $html .= hl('iface', esc($tok)); }
                else                                  { $html .= esc($tok); }
                $prev_word = $tok;
                next;
            }
            # fallback: consume one char
            $html .= esc(substr($rest, 0, 1)); $rest = substr($rest, 1);
        }
        push @out, $html;
    }
    return join("\n", @out);
}

# Register the highlighters. Add new models here.
$SYNTAX_HIGHLIGHTERS{'cisco-ios'}     = \&highlight_cisco_ios;
$SYNTAX_HIGHLIGHTERS{'cisco-ios-ssh'} = \&highlight_cisco_ios;
$SYNTAX_HIGHLIGHTERS{'procurve'}      = \&highlight_procurve;
$SYNTAX_HIGHLIGHTERS{'procurve-ssh'}  = \&highlight_procurve;
$SYNTAX_HIGHLIGHTERS{'comware-ssh'}   = \&highlight_comware;
$SYNTAX_HIGHLIGHTERS{'zyxel'}         = \&highlight_zyxel;
# PLANET switches use a plain Cisco-IOS-like config (! comments,
# "interface GigabitEthernetX/Y", etc.), so the IOS highlighter fits.
$SYNTAX_HIGHLIGHTERS{'planet-ssh'}    = \&highlight_cisco_ios;
$SYNTAX_HIGHLIGHTERS{'aruba-cx-ssh'}  = \&highlight_aruba_cx;
$SYNTAX_HIGHLIGHTERS{'nexus-ssh'}     = \&highlight_nexus;
$SYNTAX_HIGHLIGHTERS{'mediant-sbc'}   = \&highlight_mediant;
# Synthetic key for the Tools template viewer (not a device model).
$SYNTAX_HIGHLIGHTERS{'__template__'}  = \&highlight_template;

# Model of a device (field 0 of its device-table line), or undef.
sub device_model {
    my ($dev) = @_;
    my ($line, $err) = find_device_table_line($dev);
    return undef unless defined $line;
    my @f = split /\s+/, $line;
    return $f[0];
}

# Resolve the repository directory that applies to a device, from the device
# table: the device's own repository= option first, else the "default:"
# repository= for that device's model, else the global $REPOSITORY. Returns
# undef if the device isn't found.
sub device_repository {
    my ($dev) = @_;
    my ($content, $err) = slurp_device_table();
    return undef if $err || !defined $content;
    my $recs = parse_device_table($content);

    my ($model, $dev_repo);
    my %default_repo;   # model => repository from its default: line
    for my $r (@$recs) {
        if ($r->{kind} eq 'default') {
            for my $p (@{ $r->{opts} }) {
                $default_repo{ $r->{model} } = $p->[1] if $p->[0] eq 'repository';
            }
        } elsif ($r->{kind} eq 'device' && $r->{id} eq $dev) {
            $model = $r->{model};
            for my $p (@{ $r->{opts} }) {
                $dev_repo = $p->[1] if $p->[0] eq 'repository';
            }
        }
    }
    return undef unless defined $model;                 # device not in table
    return $dev_repo if defined $dev_repo && $dev_repo ne '';
    return $default_repo{$model} if defined $default_repo{$model} && $default_repo{$model} ne '';
    return $REPOSITORY;                                 # last-resort fallback
}

# Read the per-device status file (fetchconfig >= 9.52 writes
# "<repository>/<device-id>.status") and return a hashref with the fields we
# show in the Backup Now spinner: { duration, state, changed } -- each only
# present if found. Returns undef if there's no readable status file. $dev is
# already validated ^[\w.\-]+$ (no slashes/..), so the path is safe.
sub device_status_info {
    my ($dev) = @_;
    return undef unless valid_id($dev);
    my $repo = device_repository($dev);
    return undef unless defined $repo && $repo ne '';
    my $path = "$repo/$dev.status";
    open(my $fh, '<', $path) or return undef;
    my %info;
    while (my $line = <$fh>) {
        $line =~ s/\r?\n$//;
        if (!defined $info{duration} && $line =~ /^\s*backup_duration_sec\s*=\s*(\d+)\s*$/) {
            $info{duration} = $1;
        } elsif (!defined $info{state} && $line =~ /^\s*backup_state\s*=\s*(\S+)/) {
            $info{state} = $1;
        } elsif (!defined $info{changed} && $line =~ /^\s*backup_changed\s*=\s*(\S+)/) {
            $info{changed} = $1;
        }
    }
    close($fh);
    return (%info) ? \%info : undef;
}

# Parse a status file into a hashref of all its fields (start/end date+time,
# duration, state, changed). Returns undef if unreadable. Generic key=value
# reader restricted to the fields we display.
sub read_status_file {
    my ($path) = @_;
    open(my $fh, '<', $path) or return undef;
    my %info;
    while (my $line = <$fh>) {
        $line =~ s/\r?\n$//;
        if    ($line =~ /^\s*backup_start_date\s*=\s*(\S+)/)     { $info{start_date} //= $1; }
        elsif ($line =~ /^\s*backup_start_time\s*=\s*(\S+)/)     { $info{start_time} //= $1; }
        elsif ($line =~ /^\s*backup_end_date\s*=\s*(\S+)/)       { $info{end_date}   //= $1; }
        elsif ($line =~ /^\s*backup_end_time\s*=\s*(\S+)/)       { $info{end_time}   //= $1; }
        elsif ($line =~ /^\s*backup_duration_sec\s*=\s*(\d+)/)   { $info{duration}   //= $1; }
        elsif ($line =~ /^\s*backup_state\s*=\s*(\S+)/)          { $info{state}      //= $1; }
        elsif ($line =~ /^\s*backup_changed\s*=\s*(\S+)/)        { $info{changed}    //= $1; }
    }
    close($fh);
    return \%info;
}

# Read the status file for every device in the device table, resolving each
# device's repository (its own repository= option, else its model's default:
# repository=, else the global $REPOSITORY). Returns an arrayref of hashrefs:
#   { id, info => {status fields} | undef }   (info undef = no status file)
# in device-table order. Parses the device table once for efficiency.
sub read_all_status {
    my ($content, $err) = slurp_device_table();
    return ([], $err) if $err;
    my $recs = parse_device_table($content);

    my %default_repo;   # model => default: repository
    for my $r (@$recs) {
        next unless $r->{kind} eq 'default';
        for my $p (@{ $r->{opts} }) {
            $default_repo{ $r->{model} } = $p->[1] if $p->[0] eq 'repository';
        }
    }

    my @rows;
    for my $r (@$recs) {
        next unless $r->{kind} eq 'device';
        my $dev = $r->{id};
        my $repo;
        for my $p (@{ $r->{opts} }) { $repo = $p->[1] if $p->[0] eq 'repository'; }
        $repo = $default_repo{ $r->{model} } if (!defined $repo || $repo eq '');
        $repo = $REPOSITORY                    if (!defined $repo || $repo eq '');
        my $info;
        if (defined $repo && $repo ne '' && valid_id($dev)) {
            $info = read_status_file("$repo/$dev.status");
        }
        push @rows, { id => $dev, info => $info };
    }
    return (\@rows, undef);
}


sub is_web_binary_model {
    my ($model) = @_;
    return 0 unless defined $model;
    return ($model eq 'tplink-web-sg105e' || $model eq 'procurve-web-1700') ? 1 : 0;
}

# The download filename for a web-binary model's decoded config. The switches
# expect different names on their restore pages, so it's per-model:
# ProCurve 1700 -> "<dev>-switch.cfg", TP-Link -> "<dev>-config.cfg".
sub web_config_filename {
    my ($model, $dev) = @_;
    my $suffix = (defined $model && $model eq 'procurve-web-1700')
        ? '-switch.cfg' : '-config.cfg';
    return "$dev$suffix";
}

sub show_backup_content {
    my ($user, $dev, $idx) = @_;

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev) && $idx =~ /^\d+$/) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id or backup index.</p>\n};
        print page_foot();
        return;
    }

    my ($content, $err) = get_backup_content($dev, $idx);

    print page_head("$dev #$idx", $user, 'full');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="} . esc(script_url()) . qq{">&larr; Devices</a>}
        . qq{<span class="sep">/</span>}
        . qq{<a class="btn btn-green" href="} . esc(script_url() . '?dev=' . CGI::escape($dev)) . qq{">}
        . esc($dev) . qq{</a></p>\n};
    print qq{<h1>} . esc($dev) . qq{ - backup #} . esc($idx) . qq{</h1>\n};

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } else {
        my $model = device_model($dev);
        if (is_web_binary_model($model)) {
            # These web-GUI switches store opaque binary config files
            # (uuencoded); there's nothing useful to show as text. Offer a
            # download that transparently uudecodes to the real binary.
            my $dl = script_url() . '?action=download_config&dev=' . CGI::escape($dev)
                   . '&idx=' . CGI::escape($idx);
            print qq{<p class="muted">This is a web-managed switch with no CLI. }
                . qq{Its backup is an opaque binary configuration file (stored }
                . qq{uuencoded), not text &mdash; so there's nothing to display }
                . qq{here. Download the decoded file below; it is what the }
                . qq{switch's config-restore page expects.</p>\n};
            print qq{<p><a class="btn btn-green" href="} . esc($dl) . qq{">}
                . qq{Download } . esc(web_config_filename($model, $dev)) . qq{</a></p>\n};
        } else {
            # Syntax-highlight the config if a highlighter is registered for
            # this device's model; otherwise show the plain escaped text. The
            # highlighter output is already HTML-escaped (and secret-masked).
            my $highlighted = highlight_config($model, $content);
            my $body = defined $highlighted ? $highlighted : esc($content);
            my $hl_class = defined $highlighted ? ' hl' : '';

            print qq{<div class="config-wrap">\n};
            print copy_button_html();
            print qq{<pre class="config$hl_class" id="config-content">} . $body . qq{</pre>\n};
            print qq{</div>\n};
            print copy_button_script();
            print top_bottom_nav();
        }
    }
    print page_foot();
}

# Download the NEWEST backup's configuration for a device as a file. For the
# web-binary models (TP-Link / ProCurve 1700) it transparently uudecodes and
# uses their per-model name; for normal text models it serves the raw config
# named "<dev>-YYMMDD-HHMMSS.cfg" (date/time from the backup file's own
# timestamp). The newest backup is index 1 (list_backups is newest-first).
sub download_latest_config {
    my ($user, $dev) = @_;

    unless (valid_id($dev)) {
        print $cgi->header(-type => 'text/plain', -status => '400 Bad Request');
        print "Invalid device id.\n";
        return;
    }

    my ($backups, $lerr) = list_backups($dev);
    if ($lerr) {
        print $cgi->header(-type => 'text/plain', -status => '502 Bad Gateway');
        print "Could not list backups: $lerr\n";
        return;
    }
    unless (@$backups) {
        print $cgi->header(-type => 'text/plain', -status => '404 Not Found');
        print "No backups available for this device.\n";
        return;
    }
    # Newest = index 1; find it (fall back to the first listed).
    my ($newest) = grep { $_->{idx} == 1 } @$backups;
    $newest = $backups->[0] unless $newest;

    my ($content, $err) = get_backup_content($dev, $newest->{idx});
    if ($err || !defined $content) {
        print $cgi->header(-type => 'text/plain', -status => '502 Bad Gateway');
        print "Could not retrieve backup: " . ($err // 'unknown error') . "\n";
        return;
    }

    my $model = device_model($dev);
    if (is_web_binary_model($model)) {
        # Binary web-GUI config: uudecode and use the per-model filename.
        my ($bytes, $derr) = uudecode_content($content);
        if ($derr) {
            print $cgi->header(-type => 'text/plain', -status => '500 Internal Server Error');
            print "Could not decode backup: $derr\n";
            return;
        }
        my $fname = web_config_filename($model, $dev);
        print $cgi->header(
            -type           => 'application/octet-stream',
            -attachment     => $fname,
            -Content_Length => length($bytes),
        );
        binmode(STDOUT);
        print $bytes;
        return;
    }

    # Normal text config: name it "<dev>-YYMMDD-HHMMSS<ext>" from the backup
    # file's own timestamp (parsed from its path). <ext> is the suffix
    # fetchconfig appended (filename_append_suffix) if there is one, else
    # ".cfg". Falls back to "<dev><ext>" if the timestamp can't be read.
    my $stamp  = backup_compact_stamp($newest->{path});
    my $suffix = backup_name_suffix($newest->{path});
    my $ext    = $suffix ne '' ? $suffix : '.cfg';
    my $fname  = $stamp ne '' ? "$dev-$stamp$ext" : "$dev$ext";
    # get_backup_content returns raw bytes (UTF-8 passthrough); serve as-is.
    print $cgi->header(
        -type           => 'application/octet-stream',
        -attachment     => $fname,
        -Content_Length => length($content),
    );
    binmode(STDOUT);
    print $content;
}

# Compact "YYMMDD-HHMMSS" timestamp from a backup file path
# ("...run.20260914.000000CEST" -> "260914-000000"), or '' if not present.
sub backup_compact_stamp {
    my ($path) = @_;
    return '' unless defined $path;
    (my $base = $path) =~ s{.*/}{};
    # "...run.YYYYMMDD.HHMMSS[TZ]" -> take last 2 of year + MM + DD + HHMMSS.
    # Not end-anchored, so a filename_append_suffix after the timezone (dotted
    # or not) doesn't prevent the match.
    if ($base =~ /\.\d{2}(\d{2})(\d{2})(\d{2})\.(\d{2})(\d{2})(\d{2})[A-Za-z]*/) {
        return "$1$2$3-$4$5$6";
    }
    return '';
}

# The suffix fetchconfig appended to a backup filename via
# filename_append_suffix, or '' if none. Only a DOTTED suffix is recognised
# (".txt", ".conf", ".bak.gz"): a dot-less one can't be reliably separated
# from the timezone letters, so it's treated as "no suffix".
sub backup_name_suffix {
    my ($path) = @_;
    return '' unless defined $path;
    (my $base = $path) =~ s{.*/}{};
    return ($base =~ /\.\d{8}\.\d{6}[A-Za-z]*(\.[^.].*)$/) ? $1 : '';
}

# Serve a TP-Link Easy Smart backup as a downloadable file, transparently
# uudecoding the stored backup into the real (binary) config file. The stored
# backup is uuencoded ("begin 644 <name>.cfg" ... "end"); we decode the body
# lines with unpack("u") and send the raw bytes as an attachment whose name
# is per-model ("<dev>-switch.cfg" for ProCurve 1700, "<dev>-config.cfg" for
# TP-Link).
sub download_tplink_config {
    my ($user, $dev, $idx) = @_;

    unless (valid_id($dev) && $idx =~ /^\d+$/) {
        print $cgi->header(-type => 'text/plain', -status => '400 Bad Request');
        print "Invalid device id or backup index.\n";
        return;
    }

    my ($content, $err) = get_backup_content($dev, $idx);
    if ($err || !defined $content) {
        print $cgi->header(-type => 'text/plain', -status => '502 Bad Gateway');
        print "Could not retrieve backup: " . ($err // 'unknown error') . "\n";
        return;
    }

    my ($bytes, $derr) = uudecode_content($content);
    if ($derr) {
        print $cgi->header(-type => 'text/plain', -status => '500 Internal Server Error');
        print "Could not decode backup: $derr\n";
        return;
    }

    # Filename is per-model (ProCurve 1700 -> "-switch.cfg", TP-Link ->
    # "-config.cfg"). $dev matches ^[\w.\-]+$ so it's safe in the header.
    my $fname = web_config_filename(device_model($dev), $dev);
    print $cgi->header(
        -type                  => 'application/octet-stream',
        -attachment            => $fname,
        -Content_Length        => length($bytes),
    );
    binmode(STDOUT);
    print $bytes;
}

# Decode uuencoded text ("begin <mode> <name>" ... "end") to the raw bytes.
# Tolerates leading log/blank lines before "begin". Returns ($bytes, undef)
# or (undef, $errmsg).
sub uudecode_content {
    my ($text) = @_;
    return (undef, 'empty backup') unless defined $text && $text ne '';
    my @lines = split /\n/, $text, -1;
    my $in = 0;
    my $data = '';
    my $saw_begin = 0;
    for my $line (@lines) {
        $line =~ s/\r$//;
        if (!$in) {
            if ($line =~ /^begin\s+[0-7]+\s+\S/) { $in = 1; $saw_begin = 1; }
            next;
        }
        last if $line =~ /^end\s*$/;
        next if $line eq '';
        # A uuencoded data line; unpack("u") decodes one line at a time.
        $data .= unpack('u', $line);
    }
    return (undef, 'no uuencoded "begin" header found') unless $saw_begin;
    return ($data, undef);
}

# Copy-to-clipboard button markup. Must be paired with a
# <pre id="config-content"> immediately after it, and copy_button_script()
# printed once later in the same page.
sub copy_button_html {
    return qq{<button type="button" class="copy-btn" id="copy-btn" }
        . qq{title="Copy to clipboard" aria-label="Copy to clipboard">}
        . qq{<svg viewBox="0 0 24 24" aria-hidden="true"><path }
        . qq{d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11}
        . qq{a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"/></svg>}
        . qq{<span id="copy-label">Copy</span></button>\n};
}

sub copy_button_script {
    return <<'JS';
<script>
(function () {
    var btn = document.getElementById('copy-btn');
    var label = document.getElementById('copy-label');
    var pre = document.getElementById('config-content');
    if (!btn || !pre) return;

    function done(ok) {
        label.textContent = ok ? 'Copied!' : 'Copy failed';
        setTimeout(function () { label.textContent = 'Copy'; }, 1500);
    }

    function fallbackCopy(text) {
        // On plain HTTP navigator.clipboard is unavailable, so we use the
        // legacy execCommand path. To keep Unicode (e.g. umlauts) intact --
        // a raw textarea+execCommand can hand the OS clipboard the system
        // codepage on some browsers -- we intercept the 'copy' event and set
        // the clipboard data explicitly as UTF-8 text/plain. A hidden,
        // selected textarea is still needed so execCommand('copy') fires.
        var handler = function (e) {
            if (e.clipboardData) {
                e.clipboardData.setData('text/plain', text);
                e.preventDefault();
            }
        };
        document.addEventListener('copy', handler);
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-1000px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        ta.setSelectionRange(0, text.length);
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.removeEventListener('copy', handler);
        document.body.removeChild(ta);
        done(ok);
    }

    btn.addEventListener('click', function () {
        var text = pre.textContent;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
                function () { done(true); },
                function () { fallbackCopy(text); }
            );
        } else {
            fallbackCopy(text);
        }
    });
})();
</script>
JS
}

sub show_compare {
    my ($user) = @_;
    my $dev = $cgi->param('dev') // '';
    my @sel = $cgi->multi_param('sel');

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev)) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id.</p>\n};
        print page_foot();
        return;
    }

    print page_head("Compare: $dev", $user, 'full');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="} . esc(script_url()) . qq{">&larr; Devices</a>}
        . qq{<span class="sep">/</span>}
        . qq{<a class="btn btn-green" href="} . esc(script_url() . '?dev=' . CGI::escape($dev)) . qq{">}
        . esc($dev) . qq{</a></p>\n};
    print qq{<h1>Compare backups: } . esc($dev) . qq{</h1>\n};

    # De-dup and validate indices; require exactly two.
    my %seen;
    my @idxs = grep { !$seen{$_}++ } grep { /^\d+$/ } @sel;

    if (@idxs != 2) {
        my $got = scalar(@idxs);
        print qq{<p class="error">Please select exactly two backups to compare }
            . qq{(you selected $got). Go back and tick two, then press Compare.</p>\n};
        print page_foot();
        return;
    }

    # fetchconfig.pl's -m mode requires M > N, where N (-n) is the newer
    # backup and M (-m) is the older one -- and our backup index convention
    # (1=latest, 2=next most recent, ...) means "newer" = smaller number.
    my ($n, $m) = sort { $a <=> $b } @idxs;

    print qq{<p>Comparing backup #} . esc($n) . qq{ (newer) and backup #}
        . esc($m) . qq{ (older).</p>\n};

    my ($diff_text, $status, $err) = compare_backups($dev, $n, $m);

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } elsif ($status == 0) {
        print qq{<p>The two backups are identical.</p>\n};
    } elsif ($status == 1) {
        print diff_legend_unified();
        print render_unified_diff($diff_text);
    } else {
        print qq{<p class="error">fetchconfig.pl -m failed (exit $status): }
            . esc($diff_text) . qq{</p>\n};
    }
    print page_foot();
}

# Render a unified/normal diff as a dark <pre> block with each line colored
# by its leading marker: '+'/'>' added (green), '-'/'<' removed (red),
# '@@'/'***'/'---' hunk headers (blue), everything else plain. Works for
# both `diff -u` and traditional `diff` output, since we key only on the
# first character(s). Each line is esc()'d individually, so content is
# still fully escaped -- we only wrap it in a coloring <span>.
sub render_unified_diff {
    my ($text, $unmask) = @_;
    my $esc_text = $unmask ? sub { CGI::escapeHTML($_[0]) } : sub { esc($_[0]) };
    my $html = qq{<pre class="config">};
    for my $line (split /\n/, $text, -1) {
        my $cls = '';
        if    ($line =~ /^\+\+\+/ || $line =~ /^---/ || $line =~ /^\@\@/ || $line =~ /^\*\*\*/) { $cls = 'd-hunk'; }
        elsif ($line =~ /^[+>]/) { $cls = 'd-add'; }
        elsif ($line =~ /^[-<]/) { $cls = 'd-del'; }
        if ($cls ne '') {
            $html .= qq{<span class="$cls">} . $esc_text->($line) . qq{</span>\n};
        } else {
            $html .= $esc_text->($line) . qq{\n};
        }
    }
    $html .= qq{</pre>\n};
    return $html;
}

# Build a unified-style diff STRING from two texts, in-app (for the Tools
# "compare configs" feature, where there's no fetchconfig.pl -m to call).
# Uses Algorithm::Diff::sdiff and emits ONLY the changed lines: "-old"
# (removed/changed-from) and "+new" (added/changed-to). Unchanged context
# lines are omitted. Returns (\$diff_text, $identical).
sub build_unified_diff {
    my ($left_text, $right_text) = @_;
    my @left  = split /\n/, (defined $left_text  ? $left_text  : ''), -1;
    my @right = split /\n/, (defined $right_text ? $right_text : ''), -1;
    pop @left  if @left  && $left[-1]  eq '';
    pop @right if @right && $right[-1] eq '';

    my @sd = sdiff(\@left, \@right);
    my $identical = !grep { $_->[0] ne 'u' } @sd;
    my @out;
    for my $row (@sd) {
        my ($flag, $l, $r) = @$row;
        if    ($flag eq 'c') { push @out, "-$l", "+$r"; }
        elsif ($flag eq '-') { push @out, "-$l"; }
        elsif ($flag eq '+') { push @out, "+$r"; }
        # 'u' (unchanged) lines are omitted.
    }
    return (join("\n", @out), $identical);
}

# Shared colour legend shown above both the unified and side-by-side diffs.
sub diff_legend {
    return qq{<p class="diff-legend">}
         . qq{<span class="sw sw-add"></span>added}
         . qq{<span class="sw sw-del"></span>removed}
         . qq{<span class="sw sw-chg"></span>changed</p>\n};
}

# Legend for the unified diff, which only distinguishes old vs. new lines
# (removed/added) -- there is no separate "changed" colour there. The
# swatches use the same red/green as the dark diff block itself.
sub diff_legend_unified {
    return qq{<p class="diff-legend">}
         . qq{<span class="sw sw-uni-del"></span>red = old}
         . qq{<span class="sw sw-uni-add"></span>green = new</p>\n};
}

# Side-by-side comparison of two backups, computed in-app with
# Algorithm::Diff::sdiff() rather than fetchconfig.pl's own -m diff. We
# fetch both configs (same -g retrieval the single-backup view uses) and
# lay them out in two aligned columns, coloured per row: added (green),
# removed (red), changed (amber), unchanged (plain). Kept as a distinct
# action from show_compare() so the CLI-native unified diff stays exactly
# as it was; this is an additional view, not a replacement.
sub show_side_by_side {
    my ($user) = @_;
    my $dev = $cgi->param('dev') // '';
    my @sel = $cgi->multi_param('sel');

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev)) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id.</p>\n};
        print page_foot();
        return;
    }

    print page_head("Side by side: $dev", $user, 'wide');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="} . esc(script_url()) . qq{">&larr; Devices</a>}
        . qq{<span class="sep">/</span>}
        . qq{<a class="btn btn-green" href="} . esc(script_url() . '?dev=' . CGI::escape($dev)) . qq{">}
        . esc($dev) . qq{</a></p>\n};
    print qq{<h1>Side by side: } . esc($dev) . qq{</h1>\n};

    my %seen;
    my @idxs = grep { !$seen{$_}++ } grep { /^\d+$/ } @sel;

    if (@idxs != 2) {
        my $got = scalar(@idxs);
        print qq{<p class="error">Please select exactly two backups to compare }
            . qq{(you selected $got). Go back and tick two, then press Side by Side.</p>\n};
        print page_foot();
        return;
    }

    # Same ordering convention as the unified compare: smaller index = newer.
    my ($n, $m) = sort { $a <=> $b } @idxs;

    my ($newer, $err_n) = get_backup_content($dev, $n);
    my ($older, $err_m) = get_backup_content($dev, $m);
    if ($err_n || $err_m) {
        print qq{<p class="error">} . esc($err_n || $err_m) . qq{</p>\n};
        print page_foot();
        return;
    }

    print qq{<p>Backup #} . esc($m) . qq{ (older) on the left, backup #}
        . esc($n) . qq{ (newer) on the right.</p>\n};

    # Left = older, right = newer, so the columns read "before -> after".
    print render_side_by_side($older, $newer, "backup #$m (older)", "backup #$n (newer)");
    print top_bottom_nav();
    print page_foot();
}

# Floating "Top" / "Bottom" navigation, fixed in the bottom-right corner, to
# jump quickly to either end of a long side-by-side diff. Placed at the
# bottom (not the top) so it never overlaps the title bar's Log out link.
sub top_bottom_nav {
    return <<'HTML';
<div class="page-nav">
  <button type="button" class="btn btn-small" id="page-nav-top" title="Jump to top">&#9650; Top</button>
  <button type="button" class="btn btn-small" id="page-nav-bottom" title="Jump to bottom">&#9660; Bottom</button>
</div>
<script>
(function () {
  var t = document.getElementById('page-nav-top');
  var b = document.getElementById('page-nav-bottom');
  function to(y) {
    try { window.scrollTo({ top: y, behavior: 'smooth' }); }
    catch (e) { window.scrollTo(0, y); }   // older browsers: no smooth option
  }
  if (t) t.addEventListener('click', function () { to(0); });
  if (b) b.addEventListener('click', function () {
    var h = document.documentElement.scrollHeight || document.body.scrollHeight;
    to(h);
  });
})();
</script>
HTML
}

# Normalize a config's whitespace for comparison: per line, collapse every
# run of whitespace (spaces/tabs) to a single space and trim the ends --
# EXCEPT inside double-quoted spans, whose contents are preserved verbatim.
# This lets two device tables that differ only in tab-vs-space alignment
# compare as identical, while a real change inside a quoted value (e.g. a
# comment) still shows. Used by the Tools "compare configs" feature.
sub normalize_config_ws {
    my ($text) = @_;
    return '' unless defined $text;
    my @out;
    for my $line (split /\n/, $text, -1) {
        my $res = '';
        my $in_q = 0;
        # Walk the line; outside quotes, squeeze whitespace to one space.
        for my $ch (split //, $line) {
            if ($ch eq '"') { $in_q = !$in_q; $res .= $ch; }
            elsif (!$in_q && $ch =~ /\s/) {
                $res .= ' ' unless substr($res, -1) eq ' ';
            }
            else { $res .= $ch; }
        }
        $res =~ s/^ | $//g;   # trim (single leading/trailing space at most)
        push @out, $res;
    }
    # Drop a trailing empty element from a final newline.
    pop @out if @out && $out[-1] eq '';
    return join("\n", @out) . (@out ? "\n" : '');
}


# a row per aligned pair: 'u' unchanged, 'c' changed, '+' added on the
# right (absent left), '-' removed from the left (absent right). We keep an
# independent line counter per side so the gutter shows each side's real
# line number, blank where that side has no line for the row.
sub render_side_by_side {
    my ($left_text, $right_text, $left_label, $right_label, $unmask) = @_;
    # $unmask (optional): when true, the config line text is HTML-escaped
    # but NOT secret-masked -- used by the admin-only Tools "compare configs"
    # feature. Everywhere else (the device-page side-by-side) it stays masked.
    my $esc_text = $unmask ? sub { CGI::escapeHTML($_[0]) } : sub { esc($_[0]) };
    my @left  = split /\n/, (defined $left_text  ? $left_text  : ''), -1;
    my @right = split /\n/, (defined $right_text ? $right_text : ''), -1;
    # A trailing newline yields a spurious empty final element; drop it so
    # the last real line isn't followed by a phantom blank row.
    pop @left  if @left  && $left[-1]  eq '';
    pop @right if @right && $right[-1] eq '';

    my @sd = sdiff(\@left, \@right);

    my $identical = !grep { $_->[0] ne 'u' } @sd;
    if ($identical) {
        return qq{<p>The two configurations are identical.</p>\n};
    }

    my $html = diff_legend();
    $html .= qq{<div class="sbs-scroll">\n};
    $html .= qq{<table class="sbs">\n};
    $html .= qq{<colgroup><col class="gutter"><col class="side"><col class="gutter"><col class="side"></colgroup>\n};
    $html .= qq{<tr><th colspan="2">} . esc($left_label) . qq{</th>}
           . qq{<th colspan="2">} . esc($right_label) . qq{</th></tr>\n};

    my ($ln_l, $ln_r) = (0, 0);
    for my $row (@sd) {
        my ($flag, $l, $r) = @$row;
        my ($rowcls, $lcls, $rcls, $lnum, $rnum, $ltxt, $rtxt);
        if ($flag eq 'u') {
            $ln_l++; $ln_r++;
            ($rowcls, $lnum, $rnum, $ltxt, $rtxt) = ('', $ln_l, $ln_r, $l, $r);
            ($lcls, $rcls) = ('txt', 'txt');
        } elsif ($flag eq 'c') {
            $ln_l++; $ln_r++;
            ($rowcls, $lnum, $rnum, $ltxt, $rtxt) = ('d-chg', $ln_l, $ln_r, $l, $r);
            ($lcls, $rcls) = ('txt', 'txt');
        } elsif ($flag eq '-') {
            $ln_l++;
            ($rowcls, $lnum, $rnum, $ltxt, $rtxt) = ('d-del', $ln_l, '', $l, '');
            ($lcls, $rcls) = ('txt', 'empty');
        } elsif ($flag eq '+') {
            $ln_r++;
            ($rowcls, $lnum, $rnum, $ltxt, $rtxt) = ('d-add', '', $ln_r, '', $r);
            ($lcls, $rcls) = ('empty', 'txt');
        }
        $html .= qq{<tr class="$rowcls">}
               . qq{<td class="ln">} . esc($lnum) . qq{</td>}
               . qq{<td class="$lcls">} . $esc_text->($ltxt) . qq{</td>}
               . qq{<td class="ln">} . esc($rnum) . qq{</td>}
               . qq{<td class="$rcls">} . $esc_text->($rtxt) . qq{</td>}
               . qq{</tr>\n};
    }
    $html .= qq{</table>\n</div>\n};
    return $html;
}

sub show_backup_now {
    my ($user) = @_;
    my $dev = $cgi->param('dev') // '';

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev)) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id.</p>\n};
        print page_foot();
        return;
    }

    print page_head("Backup Now: $dev", $user, 'checkout');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="} . esc(script_url()) . qq{">&larr; Devices</a>}
        . qq{<span class="sep">/</span>}
        . qq{<a class="btn btn-green" href="} . esc(script_url() . '?dev=' . CGI::escape($dev)) . qq{">}
        . esc($dev) . qq{</a></p>\n};
    print qq{<h1>Backup Now: } . esc($dev) . qq{</h1>\n};

    my ($output, $status, $err) = run_backup_now($dev);
    my $return_link = script_url() . '?dev=' . CGI::escape($dev);

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } else {
        if (defined $status && $status == 0) {
            print qq{<p class="success">Backup run finished (exit 0).</p>\n};
        } else {
            print qq{<p class="error">Backup run exited with status }
                . esc($status) . qq{ -- see output below.</p>\n};
        }
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">} . esc($output) . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    }

    print qq{<p><a class="btn" href="} . esc($return_link) . qq{">}
        . qq{Return to backups for } . esc($dev) . qq{</a></p>\n};
    print page_foot();
}

# Check for empty backup files on disk via `fetchconfig.pl -z dev_id`, and
# show the tool's report in the same layout as Backup Now (breadcrumb,
# heading, status line, copyable output block). Read-only: -z only inspects
# the files already in the repository, so this uses the same non-sudo
# run_fetchconfig() path as -l/-g, not the sudo Backup Now path.
sub show_check_empty {
    my ($user) = @_;
    my $dev = $cgi->param('dev') // '';

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev)) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id.</p>\n};
        print page_foot();
        return;
    }

    print page_head("Check empty backups: $dev", $user, "checkout");
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="} . esc(script_url()) . qq{">&larr; Devices</a>}
        . qq{<span class="sep">/</span>}
        . qq{<a class="btn btn-green" href="} . esc(script_url() . '?dev=' . CGI::escape($dev)) . qq{">}
        . esc($dev) . qq{</a></p>\n};
    print qq{<h1>Check empty backups: } . esc($dev) . qq{</h1>\n};
    print qq{<p class="muted">Result of <code>fetchconfig.pl -z </code>}
        . esc($dev) . qq{, which inspects the backup files already on disk.</p>\n};

    my ($output, $status, $err) = run_check_empty($dev);
    my $return_link = script_url() . '?dev=' . CGI::escape($dev);

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } else {
        if (defined $status && $status == 0) {
            print qq{<p class="success">No empty backups found (exit 0).</p>\n};
        } elsif (defined $status && $status == 1) {
            print qq{<p class="error">One or more empty (zero-byte) backups found (exit 1) -- see output below.</p>\n};
        } else {
            print qq{<p class="error">Check exited with status }
                . esc($status) . qq{ -- see output below.</p>\n};
        }
        my $shown = (defined $output && $output ne '') ? $output
                  : "(fetchconfig.pl -z produced no output.)";
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">} . esc($shown) . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    }

    print qq{<p><a class="btn" href="} . esc($return_link) . qq{">}
        . qq{Return to backups for } . esc($dev) . qq{</a></p>\n};
    print page_foot();
}

# Per-device page: full output of `fetchconfig.pl -s dev_id`, which reports
# whether the device's backup files have consistent extensions/suffixes.
# Same layout as show_check_empty (raw transcript in a copyable block).
sub show_check_suffix {
    my ($user) = @_;
    my $dev = $cgi->param('dev') // '';

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (valid_id($dev)) {
        print page_head('Error', $user);
        print qq{<p class="error">Invalid device id.</p>\n};
        print page_foot();
        return;
    }

    print page_head("Check backup suffixes: $dev", $user, "checkout");
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="} . esc(script_url()) . qq{">&larr; Devices</a>}
        . qq{<span class="sep">/</span>}
        . qq{<a class="btn btn-green" href="} . esc(script_url() . '?dev=' . CGI::escape($dev)) . qq{">}
        . esc($dev) . qq{</a></p>\n};
    print qq{<h1>Check backup suffixes: } . esc($dev) . qq{</h1>\n};
    print qq{<p class="muted">Result of <code>fetchconfig.pl -s </code>}
        . esc($dev) . qq{, which checks that the device's stored backup files }
        . qq{all use the same filename extension.</p>\n};

    my ($output, $status, $err) = run_check_suffix($dev);
    my $return_link = script_url() . '?dev=' . CGI::escape($dev);

    if ($err) {
        print qq{<p class="error">} . esc($err) . qq{</p>\n};
    } else {
        my ($cls, $msg) = suffix_rc_message($status);
        print qq{<p class="$cls">} . esc($msg) . qq{</p>\n};
        my $shown = (defined $output && $output ne '') ? $output
                  : "(fetchconfig.pl -s produced no output.)";
        print qq{<div class="config-wrap">\n};
        print copy_button_html();
        print qq{<pre class="config" id="config-content">} . esc($shown) . qq{</pre>\n};
        print qq{</div>\n};
        print copy_button_script();
    }

    print qq{<p><a class="btn" href="} . esc($return_link) . qq{">}
        . qq{Return to backups for } . esc($dev) . qq{</a></p>\n};
    print page_foot();
}

# =============================================================================
# Tools (admin only): orphaned-backup check and delete
# =============================================================================

# True if this user may use the Tools page: any admin (built-in
# $PROTECTED_USER or a user with admin_function). Opens its own DB handle.
sub user_may_use_tools {
    my ($user) = @_;
    return 0 unless defined $user;
    return 1 if $user eq $PROTECTED_USER;
    my $dbh = db_connect() or return 0;
    my $ok = user_is_admin($dbh, $user);
    $dbh->disconnect;
    return $ok;
}

# The Tools landing page: two buttons. "Check for orphaned backups" is a
# read-only GET; "Delete orphaned backups" is a POST (destructive) with a
# JS confirm() prompt and a CSRF token.
sub show_tools {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You are not allowed to use Tools.</p>\n};
        print page_foot();
        return;
    }

    print page_head('Tools', $user);
    print qq{<h1>Tools</h1>\n};
    my $flash_msg = $cgi->param('msg');
    my $flash_err = $cgi->param('err');
    if (defined $flash_msg && $flash_msg ne '') { print qq{<p class="success">} . esc($flash_msg) . qq{</p>\n}; }
    if (defined $flash_err && $flash_err ne '') { print qq{<p class="error">} . esc($flash_err) . qq{</p>\n}; }

    # Each tool group lives in its own titled box, so more tools can be
    # added later as separate boxes.
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">Orphaned Configuration Cleanup</h2>\n};
    print qq{<p class="muted">Orphaned backups are backed-up configurations }
        . qq{on disk whose device is no longer in the device table (for example, }
        . qq{a device that was decommissioned or renamed). These tools run }
        . qq{<code>fetchconfig.pl -o</code>.</p>\n};

    print qq{<h3>Check for orphaned backups</h3>\n};
    print qq{<p class="muted">Lists orphaned backups without changing anything.</p>\n};
    print qq{<p><a class="btn" href="} . esc(script_url() . '?action=orphan_check')
        . qq{">Check for orphaned backups</a></p>\n};

    print qq{<h3>Delete orphaned backups</h3>\n};
    print qq{<p class="muted">Permanently deletes the orphaned backups found }
        . qq{above (<code>fetchconfig.pl -o -D</code>). This cannot be undone.</p>\n};
    print $cgi->start_form(-method => 'POST', -action => script_url(),
        -data_confirm => 'Permanently DELETE all orphaned backups? This cannot be undone.',
        -data_confirm_danger => 'y');
    print qq{<input type="hidden" name="action" value="orphan_delete">\n};
    print csrf_field();
    print qq{<p><button type="submit" class="btn btn-danger">Delete orphaned backups</button></p>\n};
    print $cgi->end_form;
    print qq{</div>\n};   # .tool-section (Orphaned Configuration Cleanup)

    # --- Empty Directory Cleanup ----------------------------------------
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">Empty Directory Cleanup</h2>\n};
    print qq{<p class="muted">Empty directories are date }
        . qq{(<code>YYYYMM</code>/<code>YYYYMMDD</code>) or per-device directories }
        . qq{left in the repository with no files in them. A normal aged-config }
        . qq{delete run or the orphaned-configuration cleanup should remove these }
        . qq{on their own; this tool is for the occasional directory left behind }
        . qq{by something else, such as manual file operations. These tools run }
        . qq{<code>fetchconfig.pl -e</code>.</p>\n};

    print qq{<h3>Check for empty directories</h3>\n};
    print qq{<p class="muted">Lists empty directories without changing anything.</p>\n};
    print qq{<p><a class="btn" href="} . esc(script_url() . '?action=empty_check')
        . qq{">Check for empty directories</a></p>\n};

    print qq{<h3>Delete empty directories</h3>\n};
    print qq{<p class="muted">Permanently removes the empty directories found }
        . qq{above (<code>fetchconfig.pl -e -D</code>). This cannot be undone.</p>\n};
    print $cgi->start_form(-method => 'POST', -action => script_url(),
        -data_confirm => 'Permanently DELETE all empty directories? This cannot be undone.',
        -data_confirm_danger => 'y');
    print qq{<input type="hidden" name="action" value="empty_delete">\n};
    print csrf_field();
    print qq{<p><button type="submit" class="btn btn-danger">Delete empty directories</button></p>\n};
    print $cgi->end_form;
    print qq{</div>\n};   # .tool-section (Empty Directory Cleanup)

    # --- Restore device table -------------------------------------------
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">Restore device table</h2>\n};
    print qq{<p class="muted">Timestamped backups of the device table, written }
        . qq{before each save from the editor or bulk edit, are kept in }
        . qq{<code>} . esc($BACKUP_DEVICE_TABLE) . qq{</code>. You can view a backup, }
        . qq{restore it (the current table is backed up first, so a restore is itself }
        . qq{undoable), or delete it.</p>\n};

    my $backups = list_table_backups();
    if (!@$backups) {
        print qq{<p>No backups found.</p>\n};
        # Even with no backups, "current" can't be compared against nothing;
        # so only show the table when there's at least one backup.
    } else {
        # The checkboxes belong to this (initially empty) GET form; the
        # Compare button references it via HTML5 form=. The per-row
        # Restore/Delete forms stay separate (no nested forms).
        print $cgi->start_form(-method => 'GET', -action => script_url(),
            -enctype => 'application/x-www-form-urlencoded', -id => 'tools-cmp-form');
        print qq{<input type="hidden" name="action" value="compare_backups">\n};
        # Carries the "show passwords" choice into the compare request. Kept
        # in sync with the mask checkbox by JS on submit (see below).
        print qq{<input type="hidden" name="unmask" id="tools-unmask" value="0">\n};
        print $cgi->end_form;

        print qq{<p class="btn-row">}
            . qq{<button type="submit" form="tools-cmp-form" name="mode" value="unified" class="btn">Compare selected</button> }
            . qq{<button type="submit" form="tools-cmp-form" name="mode" value="sidebyside" class="btn">Side by side selected</button> }
            . qq{<label class="mask-label"><input type="checkbox" id="tools-mask" checked> Mask passwords</label> }
            . qq{<span class="muted">Tick two rows (whitespace outside quotes is ignored).</span></p>\n};

        print qq{<table class="list">\n}
            . qq{<tr><th></th><th>Backup</th><th>Size</th><th></th></tr>\n};

        # Synthetic "current" row first: selectable for compare, no actions.
        print qq{<tr>}
            . qq{<td><input type="checkbox" form="tools-cmp-form" name="sel" value="current"></td>}
            . qq{<td><strong>current</strong> <span class="muted">(live device table)</span></td>}
            . qq{<td></td><td></td></tr>\n};

        for my $b (@$backups) {
            my $n = $b->{name};
            print qq{<tr>}
                . qq{<td><input type="checkbox" form="tools-cmp-form" name="sel" value="}
                . esc($n) . qq{"></td>}
                . qq{<td>} . esc($n) . qq{</td>}
                . qq{<td>} . esc($b->{size}) . qq{ bytes</td>}
                . qq{<td><div class="row-actions">\n};
            # View (GET, read-only)
            print qq{<a class="btn view-backup-link" data-name="} . esc($n) . qq{" href="}
                . esc(script_url() . '?action=view_backup&name=' . CGI::escape($n))
                . qq{">View</a>\n};
            # Restore (POST + CSRF + confirm)
            print $cgi->start_form(-method => 'POST', -action => script_url(),
                -data_confirm => 'Restore the device table from ' . esc($n)
                    . '? The current table will be backed up first.');
            print qq{<input type="hidden" name="action" value="restore_backup">\n};
            print qq{<input type="hidden" name="name" value="} . esc($n) . qq{">\n};
            print csrf_field();
            print qq{<button type="submit" class="btn">Restore</button>\n};
            print $cgi->end_form;
            # Delete (POST + CSRF + confirm)
            print $cgi->start_form(-method => 'POST', -action => script_url(),
                -data_confirm => 'Delete backup ' . esc($n) . '? This cannot be undone.',
                -data_confirm_danger => 'y');
            print qq{<input type="hidden" name="action" value="delete_backup">\n};
            print qq{<input type="hidden" name="name" value="} . esc($n) . qq{">\n};
            print csrf_field();
            print qq{<button type="submit" class="btn btn-danger">Delete</button>\n};
            print $cgi->end_form;
            print qq{</div></td></tr>\n};
        }
        print qq{</table>\n};

        # Wire the "Mask passwords" checkbox: unchecked -> unmask=1 flows to
        # both the compare request (hidden field) and the View links (query
        # param). Checked (default) -> masked, the server default.
        print <<'JS';
<script>
(function () {
  var mask = document.getElementById('tools-mask');
  var unmaskField = document.getElementById('tools-unmask');
  var form = document.getElementById('tools-cmp-form');
  function unmaskOn() { return mask && !mask.checked; }
  if (form) {
    form.addEventListener('submit', function () {
      if (unmaskField) unmaskField.value = unmaskOn() ? '1' : '0';
    });
  }
  var links = document.querySelectorAll('a.view-backup-link');
  Array.prototype.forEach.call(links, function (a) {
    a.addEventListener('click', function (e) {
      var href = a.getAttribute('href').replace(/&unmask=[01]/, '');
      if (unmaskOn()) href += '&unmask=1';
      a.setAttribute('href', href);
    });
  });
})();
</script>
JS
        # Bulk cleanup: delete backups older than N days, always keeping the
        # newest. Only offered when there is at least one backup besides the
        # newest (otherwise there is nothing this could delete).
        if (@$backups >= 2) {
            print $cgi->start_form(-method => 'POST', -action => script_url(),
                -id => 'delete-old-form',
                -data_confirm => 'Delete all device-table backups older than the given number of days? The newest backup is always kept.',
                -data_confirm_danger => 'y');
            print qq{<input type="hidden" name="action" value="delete_old_backups">\n};
            print csrf_field();
            print qq{<p class="btn-row delete-old-row">}
                . qq{<label>Delete backups older than }
                . qq{<input type="text" inputmode="numeric" name="days" value="30" size="4"> days</label> }
                . qq{<button type="submit" class="btn btn-danger">Delete backups older than days</button> }
                . qq{<span class="muted">The newest backup is never deleted.</span></p>\n};
            print $cgi->end_form;
        }
    }
    print qq{</div>\n};   # .tool-section (Restore device table)

    # Both scan tools iterate the device list; read it once.
    my ($dev_list, $dev_err) = read_device_ids();

    # --- Devices without backups ----------------------------------------
    render_scan_tool(
        prefix   => 'nobk',
        title    => 'Devices without backups',
        descr    => 'Scans every Device-ID in the device table and lists the '
                  . 'devices that have no stored backups yet (never backed up). '
                  . 'Each device is checked with <code>fetchconfig.pl -l</code> '
                  . '(read-only).',
        action   => 'check_backups_one',
        flag     => 'none',   # status word that means "list this device"
        dev_list => $dev_list, dev_err => $dev_err,
        none_msg => 'device%s without backups',
        all_ok   => 'All %d device%s have at least one backup.',
    );

    # --- Check devices for empty backups --------------------------------
    render_scan_tool(
        prefix   => 'empty',
        title    => 'Check devices for empty backups',
        descr    => 'Scans every Device-ID in the device table and lists the '
                  . 'devices that have one or more <strong>empty</strong> '
                  . '(zero-byte) backup files &mdash; a fetch that connected '
                  . 'but saved nothing. Each device is checked with '
                  . '<code>fetchconfig.pl -z</code> (read-only).',
        action   => 'check_empty_one',
        flag     => 'empty',
        dev_list => $dev_list, dev_err => $dev_err,
        none_msg => 'device%s with empty backups',
        all_ok   => 'No devices have empty backups (checked %d device%s).',
    );

    # --- Check devices for consistent backup suffixes -------------------
    render_scan_tool(
        prefix   => 'suffix',
        title    => 'Check devices for consistent backup suffixes',
        descr    => 'Scans every Device-ID in the device table and lists the '
                  . 'devices whose stored backups do <strong>not</strong> all '
                  . 'share the same filename suffix, <strong>or</strong> whose '
                  . 'suffix does not match the configured '
                  . '<code>filename_append_suffix</code>. Each device is '
                  . 'checked with <code>fetchconfig.pl -s</code> (read-only). '
                  . '<em>Check for details on the specific device page.</em>',
        action   => 'check_suffix_one',
        flag     => 'issue',
        dev_list => $dev_list, dev_err => $dev_err,
        none_msg => 'device%s with a backup-suffix problem',
        all_ok   => 'All %d device%s have consistent backup suffixes.',
    );

    # --- fetchconfig log launcher ---------------------------------------
    render_log_section();
    render_template_section();

    print top_bottom_nav();
    print page_foot();
}

# Tools-page section: just a launcher for the log viewer, which lives on its
# own page (?action=view_log). No file read here.
sub render_log_section {
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">View fetchconfig log</h2>\n};
    print qq{<p class="muted">The output written by the scheduled (cron) }
        . qq{<code>fetchconfig.pl</code> run, shown as collapsible sections }
        . qq{(failed sections in red, expanded).</p>\n};
    if (!defined $FETCHCONFIG_LOG || $FETCHCONFIG_LOG eq '') {
        print qq{<p class="muted">No log file configured. Set }
            . qq{<code>FETCHCONFIG_LOG</code> in <code>} . esc($CONFIG_FILE) . qq{</code>.</p>\n};
    } else {
        print qq{<p><a class="btn" href="}
            . esc(script_url() . '?action=view_log') . qq{">Display log</a></p>\n};
    }
    print qq{</div>\n};   # .tool-section
}

# Tools-page section: launcher for the template viewer (?action=view_templates).
sub render_template_section {
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">Template viewer</h2>\n};
    print qq{<p class="muted">Lists the generic-model templates found in the }
        . qq{template directories <code>fetchconfig.pl -t</code> reports, and }
        . qq{lets you view each one (read-only) with syntax highlighting. The }
        . qq{same template name may appear in more than one directory.</p>\n};
    print qq{<p><a class="btn" href="}
        . esc(script_url() . '?action=view_templates') . qq{">Show templates</a></p>\n};
    print qq{</div>\n};   # .tool-section
}

# Full-page fetchconfig log viewer (?action=view_log, admin only, read-only).
# Reads FETCHCONFIG_LOG and shows it split into collapsible sections at each
# "-----[NAME]-----" header. Section names are bold; the [NAME] is green, or
# red if that section failed (its body contains "error:" or "failed"). Failed
# sections start expanded, the rest collapsed. Rendered up to LOG_MAX_DEVICES
# sections, with a warning if the log has more. A "Log table load time" line
# is shown below the output.
sub show_fetchconfig_log {
    my ($user) = @_;

    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');

    unless (user_may_use_tools($user)) {
        print page_head('Tools', $user);
        print qq{<p class="error">You do not have permission to use the tools.</p>\n};
        print page_foot();
        return;
    }

    print page_head('View fetchconfig log', $user, 'full');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=tools') . qq{">&larr; Tools</a></p>\n};
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">View fetchconfig log</h2>\n};

    if (!defined $FETCHCONFIG_LOG || $FETCHCONFIG_LOG eq '') {
        print qq{<p class="muted">No log file configured. Set }
            . qq{<code>FETCHCONFIG_LOG</code> in <code>} . esc($CONFIG_FILE) . qq{</code>.</p>\n};
        print qq{</div>\n};   # .tool-section
        print page_foot();
        return;
    }

    my $t0 = [Time::HiRes::gettimeofday()];
    open(my $fh, '<', $FETCHCONFIG_LOG) or do {
        print qq{<p class="error">Cannot read log file }
            . esc($FETCHCONFIG_LOG) . qq{: } . esc("$!") . qq{</p>\n};
        print qq{</div>\n};   # .tool-section
        print page_foot();
        return;
    };
    my @lines = <$fh>;
    close($fh);

    # Split into sections at each "-----[NAME]-----" header line. Any lines
    # before the first header form a leading (headerless) block.
    my @sections;               # each: { name, failed, body => [lines] }
    my $cur;
    my @preamble;
    for my $line (@lines) {
        $line =~ s/\r?\n$//;
        if ($line =~ /^fetchconfig\.pl:\s*info:\s*-+\[(.+?)\]-+\s*$/) {
            my $name = $1;
            push @sections, $cur if $cur;
            $cur = { name => $name, failed => 0, body => [] };
        } elsif ($cur) {
            push @{ $cur->{body} }, $line;
            $cur->{failed} = 1 if $line =~ /error:|failed/i;
        } else {
            push @preamble, $line;
        }
    }
    push @sections, $cur if $cur;
    my $load_secs = Time::HiRes::tv_interval($t0);

    my $total = scalar @sections;
    if ($total == 0) {
        print qq{<p class="muted">The log file is empty or has no recognizable }
            . qq{sections.</p>\n};
        print qq{</div>\n};   # .tool-section
        print page_foot();
        return;
    }

    # Cap at LOG_MAX_DEVICES; warn if there are more.
    my $shown = $total;
    if ($total > $LOG_MAX_DEVICES) {
        $shown = $LOG_MAX_DEVICES;
        print qq{<p class="error">The log has $total sections, more than }
            . qq{LOG_MAX_DEVICES ($LOG_MAX_DEVICES). Showing the first }
            . qq{$shown; increase LOG_MAX_DEVICES in } . esc($CONFIG_FILE) . qq{ to }
            . qq{see them all.</p>\n};
    }

    print qq{<p><button type="button" class="btn btn-small" id="log-expand-all">Expand all</button> }
        . qq{<button type="button" class="btn btn-small" id="log-collapse-all">Collapse all</button></p>\n};

    print qq{<div class="log-view">\n};
    if (@preamble) {
        # Rare: text before the first section header -- show it plain.
        print qq{<pre class="config log-preamble">} . esc(join("\n", @preamble)) . qq{</pre>\n};
    }
    for my $i (0 .. $shown - 1) {
        my $s = $sections[$i];
        my $failed = $s->{failed};
        my $body   = esc(join("\n", @{ $s->{body} }));
        my $namecls = $failed ? 'log-name-fail' : 'log-name-ok';
        my $open    = $failed ? 1 : 0;   # failed sections start expanded
        my $icon    = $open ? '&minus;' : '+';
        my $bstyle  = $open ? '' : ' style="display:none;"';
        print qq{<div class="log-section" data-open="$open">\n};
        print qq{  <div class="log-head" role="button" tabindex="0">}
            . qq{<span class="log-toggle">$icon</span> }
            . qq{<span class="log-name $namecls">[} . esc($s->{name}) . qq{]</span></div>\n};
        print qq{  <pre class="config log-body"$bstyle>$body</pre>\n};
        print qq{</div>\n};
    }
    print qq{</div>\n};   # .log-view
    # Feedback: how long reading + parsing the log took (ms under 1s, else s),
    # same small footer-style font as the device page's load-time line.
    my $load_str = $load_secs < 1
        ? sprintf('%dms', int($load_secs * 1000 + 0.5))
        : sprintf('%.2fs', $load_secs);
    print qq{<p class="dev-loadtime">Log table load time: } . esc($load_str) . qq{</p>\n};
    print log_viewer_script();
    print qq{</div>\n};   # .tool-section
    print top_bottom_nav();
    print page_foot();
}

# Format a byte count as B / KB / MB (one decimal), for the template list.
sub human_size {
    my ($n) = @_;
    $n = 0 unless defined $n;
    return "$n B"                       if $n < 1024;
    return sprintf('%.1f KB', $n/1024)  if $n < 1024*1024;
    return sprintf('%.1f MB', $n/1024/1024);
}
# Format an mtime epoch as "YYYY-MM-DD HH:MM" in local time.
sub fmt_mtime {
    my ($t) = @_;
    return '' unless $t;
    my @lt = localtime($t);
    return sprintf('%04d-%02d-%02d %02d:%02d',
        $lt[5]+1900, $lt[4]+1, $lt[3], $lt[2], $lt[1]);
}

# Template list page (?action=view_templates, admin only, read-only). Lists the
# *.tmpl files in the directories fetchconfig reports via -t, one row per file
# (de-duplicated by full path), sorted by template name.
sub show_view_templates {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You do not have permission to use the tools.</p>\n};
        print page_foot();
        return;
    }
    my $t0 = Time::HiRes::time();
    print page_head('Templates', $user, 'full');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=tools') . qq{">&larr; Tools</a></p>\n};
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">Templates</h2>\n};

    my @dirs_err;
    my $files = list_template_files(\@dirs_err);
    my $dirs  = list_template_dirs();

    if (!@$dirs) {
        print qq{<p class="muted">No template directories reported by }
            . qq{<code>fetchconfig.pl -t</code>. Check that fetchconfig 9.64+ }
            . qq{is installed and configured.</p>\n};
    } elsif (!@$files) {
        print qq{<p class="muted">No <code>*.tmpl</code> files found in the }
            . scalar(@$dirs) . qq{ template director}
            . (@$dirs == 1 ? 'y' : 'ies') . qq{.</p>\n};
    } else {
        print qq{<table class="list">\n<tr><th>Template</th><th>Full Template Name</th>}
            . qq{<th>Size</th><th>Modified</th><th></th></tr>\n};
        for my $f (@$files) {
            my $view = esc(script_url() . '?action=view_template&path='
                         . CGI::escape($f->{path}));
            print qq{<tr>}
                . qq{<td>} . esc($f->{name}) . qq{</td>}
                . qq{<td>} . esc($f->{path}) . qq{</td>}
                . qq{<td>} . esc(human_size($f->{size})) . qq{</td>}
                . qq{<td>} . esc(fmt_mtime($f->{mtime})) . qq{</td>}
                . qq{<td><a href="$view">View</a></td>}
                . qq{</tr>\n};
        }
        print qq{</table>\n};
    }
    if (@dirs_err) {
        print qq{<p class="muted">Note: could not read }
            . join(', ', map { "<code>" . esc($_) . "</code>" } @dirs_err) . qq{.</p>\n};
    }
    my $secs = Time::HiRes::time() - $t0;
    print qq{<p class="dev-loadtime">Template list load time: }
        . esc($secs < 1 ? sprintf('%dms', int($secs*1000+0.5)) : sprintf('%.2fs',$secs))
        . qq{</p>\n};
    print qq{</div>\n};   # .tool-section
    print page_foot();
}

# Single-template view (?action=view_template&path=..., admin only, read-only).
# The path MUST contain no ".." and MUST be a member of the current template
# list (exact full-path whitelist); anything else is refused.
sub show_view_template {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You do not have permission to use the tools.</p>\n};
        print page_foot();
        return;
    }

    my $path = $cgi->param('path');
    $path = '' unless defined $path;

    print page_head('Template', $user, 'full');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=view_templates') . qq{">&larr; Templates</a></p>\n};

    # Security: reject traversal and anything not in the discovered set.
    my %allowed = map { $_->{path} => 1 } @{ list_template_files() };
    if ($path eq '' || $path =~ /\.\./ || !$allowed{$path}) {
        print qq{<h1>Template</h1>\n};
        print qq{<p class="error">Template not found, or not an allowed template path.</p>\n};
        print page_foot();
        return;
    }

    (my $name = $path) =~ s{.*/}{}; $name =~ s/\.tmpl$//;
    print qq{<h1>Template: } . esc($name) . qq{</h1>\n};
    print qq{<p class="muted">} . esc($path) . qq{</p>\n};

    my $content;
    {
        open(my $fh, '<', $path) or do {
            print qq{<p class="error">Cannot read template: } . esc("$!") . qq{</p>\n};
            print page_foot();
            return;
        };
        local $/;
        $content = <$fh>;
        close($fh);
    }
    $content = '' unless defined $content;

    my $highlighted = highlight_template($content);
    my $body = defined $highlighted ? $highlighted : esc($content);
    my $hl_class = defined $highlighted ? ' hl' : '';
    print qq{<div class="config-wrap">\n};
    print copy_button_html();
    print qq{<pre class="config$hl_class" id="config-content">} . $body . qq{</pre>\n};
    print qq{</div>\n};
    print copy_button_script();
    print page_foot();
}

# Client-side expand/collapse for the log viewer.
sub log_viewer_script {
    return <<'JS';
<script>
(function () {
  var view = document.querySelector('.log-view');
  if (!view) return;
  function setOpen(sec, open) {
    sec.setAttribute('data-open', open ? '1' : '0');
    var body = sec.querySelector('.log-body');
    var tog  = sec.querySelector('.log-toggle');
    if (body) body.style.display = open ? '' : 'none';
    if (tog)  tog.innerHTML = open ? '\u2212' : '+';   // minus / plus
  }
  view.addEventListener('click', function (e) {
    var head = e.target.closest ? e.target.closest('.log-head') : null;
    if (!head) return;
    var sec = head.parentNode;
    setOpen(sec, sec.getAttribute('data-open') !== '1');
  });
  view.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var head = e.target.closest ? e.target.closest('.log-head') : null;
    if (!head) return;
    e.preventDefault();
    var sec = head.parentNode;
    setOpen(sec, sec.getAttribute('data-open') !== '1');
  });
  var ea = document.getElementById('log-expand-all');
  var ca = document.getElementById('log-collapse-all');
  if (ea) ea.addEventListener('click', function () {
    var secs = view.querySelectorAll('.log-section');
    for (var i = 0; i < secs.length; i++) setOpen(secs[i], true);
  });
  if (ca) ca.addEventListener('click', function () {
    var secs = view.querySelectorAll('.log-section');
    for (var i = 0; i < secs.length; i++) setOpen(secs[i], false);
  });
})();
</script>
JS
}

# Render a "scan every device" tool box: a titled section with a Start/Cancel
# scan button, a progress bar, and a results list, driven client-side by
# per-device JSON calls. Reused by both device-scan tools. All element IDs
# are namespaced with %opt: prefix so two boxes can coexist on the page.
sub render_scan_tool {
    my (%o) = @_;
    my $p = $o{prefix};
    print qq{<div class="tool-section">\n};
    print qq{<h2 class="tool-section-title">} . esc($o{title}) . qq{</h2>\n};
    print qq{<p class="muted">$o{descr}</p>\n};

    if ($o{dev_err}) {
        print qq{<p class="error">} . esc($o{dev_err}) . qq{</p>\n};
        print qq{</div>\n};
        return;
    }
    my $list = $o{dev_list} || [];
    if (!@$list) {
        print qq{<p>No devices found in the device table.</p>\n};
        print qq{</div>\n};
        return;
    }
    my $n = scalar @$list;
    # Device IDs match ^[\w.\-]+$, so they're safe to inline as JSON.
    my $ids_json = '[' . join(',', map { qq{"$_->{id}"} } @$list) . ']';
    print qq{<p><button type="button" class="btn" id="${p}-scan-start">Start scan</button> }
        . qq{<span class="muted">$n device} . ($n == 1 ? '' : 's') . qq{ to check.</span></p>\n};
    print qq{<div id="${p}-scan-wrap" style="display:none;">\n};
    print qq{<progress id="${p}-scan-progress" value="0" max="$n" class="scan-progress"></progress> }
        . qq{<span id="${p}-scan-count" class="muted"></span>\n};
    print qq{</div>\n};
    print qq{<div id="${p}-scan-results"></div>\n};
    print scan_tool_script($p, $ids_json, $o{action}, $o{flag}, $o{none_msg}, $o{all_ok}, $MAX_PARALLEL_SCAN);
    print qq{</div>\n};
}

# Emit the self-contained scanner script for one scan tool. Every id and the
# ids array are namespaced by $p so multiple scanners coexist. $flag is the
# JSON status word that means "list this device"; $none_msg / $all_ok are the
# result wordings (see render_scan_tool).
sub scan_tool_script {
    my ($p, $ids_json, $action, $flag, $none_msg, $all_ok, $concurrency) = @_;
    my $url = esc(script_url());
    my $conc = (defined $concurrency && $concurrency =~ /^\d+$/ && $concurrency >= 1) ? $concurrency : 1;
    # Pre-build the two result strings as JS expressions (plain scalars), so
    # the heredoc just interpolates them.
    my $all_ok_js = _all_ok_js($all_ok);
    my ($nm_pre, $nm_post) = ($none_msg =~ /^(.*?)%s(.*)$/s);
    $nm_pre  = $none_msg unless defined $nm_pre;
    $nm_post = '' unless defined $nm_post;
    my $none_lbl_js = _js_str($nm_pre) . qq{ + (flagged.length===1?'':'s') + } . _js_str($nm_post);
    return <<"JS";
<script>
(function () {
  var ids = $ids_json;
  var startBtn = document.getElementById('${p}-scan-start');
  var wrap     = document.getElementById('${p}-scan-wrap');
  var bar      = document.getElementById('${p}-scan-progress');
  var count    = document.getElementById('${p}-scan-count');
  var results  = document.getElementById('${p}-scan-results');
  if (!startBtn) return;
  var SCRIPT = "$url";
  var FLAG = "$flag";
  // Up to CONCURRENCY device checks run at once (MAX_PARALLEL_SCAN). Browsers
  // also cap connections per host (~6), which further bounds this.
  var CONCURRENCY = $conc;

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  var scanning = false;
  var inflight = [];        // XHRs currently in flight (for cancel)
  var finishCurrent = null;

  startBtn.addEventListener('click', function () {
    if (scanning) { cancelScan(); return; }
    runScan();
  });

  function cancelScan() {
    scanning = false;
    var pending = inflight.slice();
    inflight = [];
    for (var a = 0; a < pending.length; a++) {
      try { pending[a].abort(); } catch (e) {}
    }
    if (finishCurrent) finishCurrent(true);
  }

  function runScan() {
    scanning = true;
    startBtn.textContent = 'Cancel scan';
    wrap.style.display = '';
    results.innerHTML = '';
    var total = ids.length;
    var next = 0;             // index of the next device to launch
    var done = 0;             // completed (responded/failed) count
    var active = 0;           // requests currently in flight
    var flagged = [], errored = [];
    var finished = false;
    inflight = [];

    function finishScan(cancelled) {
      if (finished) return;
      finished = true;
      scanning = false;
      inflight = [];
      finishCurrent = null;
      var checked = done;
      var html = '';
      if (flagged.length === 0) {
        html = cancelled
          ? '<p class="muted">Scan cancelled after ' + checked + ' of ' + total +
            ' device' + (total===1?'':'s') + '. Nothing flagged so far.</p>'
          : '<p class="success">' + ($all_ok_js) + '</p>';
      } else {
        html = '<p>' + (cancelled ? 'Scan cancelled after ' + checked + ' of ' + total +
               ' devices. ' : '') + '<strong>' + flagged.length + '</strong> ' +
               ($none_lbl_js) +
               (cancelled ? ' so far' : '') + ':</p><ul class="scan-list">';
        for (var k = 0; k < flagged.length; k++) html += '<li>' + esc(flagged[k]) + '</li>';
        html += '</ul>';
      }
      if (errored.length) {
        html += '<p class="muted">' + errored.length + ' device' +
                (errored.length===1?'':'s') + ' could not be checked:</p><ul class="scan-list">';
        for (var e = 0; e < errored.length; e++) {
          var item = errored[e];
          html += '<li>' + esc(item.dev) +
                  (item.detail ? ' <span class="muted">(' + esc(item.detail) + ')</span>' : '') +
                  '</li>';
        }
        html += '</ul>';
      }
      results.innerHTML = html;
      startBtn.textContent = cancelled ? 'Start scan' : 'Scan again';
    }
    finishCurrent = finishScan;

    // Launch one request for device index `idx`.
    function launch(idx) {
      var dev = ids[idx];
      var xhr = new XMLHttpRequest();
      inflight.push(xhr);
      xhr.open('GET', SCRIPT + '?action=$action&dev=' + encodeURIComponent(dev), true);
      xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4) return;
        // Drop this xhr from the in-flight list.
        var pos = inflight.indexOf(xhr);
        if (pos >= 0) inflight.splice(pos, 1);
        if (!scanning) return;   // cancelled: ignore late completions
        var status = 'error';
        var detail = '';
        try {
          if (xhr.status === 200) {
            var d = JSON.parse(xhr.responseText);
            status = d.status || 'error';
            detail = d.detail || '';
          } else {
            detail = 'HTTP ' + xhr.status;
          }
        } catch (e) {
          status = 'error';
          detail = 'invalid response (HTTP ' + xhr.status + ')';
        }
        if (status === FLAG) flagged.push(dev);
        else if (status === 'error') errored.push({ dev: dev, detail: detail });
        active--;
        done++;
        bar.value = done;
        updateCount();
        pump();
      };
      xhr.send();
    }

    // Progress + how many scan processes are currently running (n of m).
    function updateCount() {
      var msg = done + ' of ' + total;
      if (done < total) {
        msg += ' \\u2014 ' + active + ' of ' + CONCURRENCY +
               ' scan process' + (CONCURRENCY === 1 ? '' : 'es') + ' in use';
      }
      count.textContent = msg;
    }

    // Keep up to CONCURRENCY requests in flight; finish when all are done.
    function pump() {
      if (!scanning) { finishScan(true); return; }
      while (active < CONCURRENCY && next < total) {
        var idx = next++;
        active++;
        launch(idx);
      }
      updateCount();
      if (active === 0 && next >= total) finishScan(false);
    }

    bar.value = 0;
    updateCount();
    pump();
  }
})();
</script>
JS
}

# Helpers for building the JS result strings from Perl. _js_str double-quotes
# a Perl string as a JS string literal; the all_ok template has a %d (count,
# filled in JS) and %s (plural) -- we pre-split it so JS can insert the count.
sub _js_str {
    my ($s) = @_;
    $s =~ s/([\\"])/\\$1/g;
    return qq{"$s"};
}
sub _all_ok_js {
    # Turn "All %d device%s ..." into a JS expression string that fills the
    # count (total) and plural at runtime. We emit it as a concatenation:
    #   "All " + total + " device" + (total===1?'':'s') + " ..."
    my ($tmpl) = @_;
    my ($pre, $mid, $post) = $tmpl =~ /^(.*?)%d(.*?)%s(.*)$/s;
    $pre  = '' unless defined $pre;
    $mid  = '' unless defined $mid;
    $post = '' unless defined $post;
    return _js_str($pre) . qq{ + total + } . _js_str($mid)
         . qq{ + (total===1?'':'s') + } . _js_str($post);
}


# Compare two device-table configs (each either "current" -- the live table
# -- or a backup, selected by checkbox on the Tools page). Whitespace outside
# quotes is normalized before diffing, so tab/space-only differences don't
# show. Rendered side-by-side (red/green), admin-only, passwords masked.
sub show_compare_backups {
    my ($user) = @_;
    print $cgi->header(-type => 'text/html', -charset => 'UTF-8');
    unless (user_may_use_tools($user)) {
        print page_head('Error', $user);
        print qq{<p class="error">You are not allowed to use Tools.</p>\n};
        print page_foot();
        return;
    }

    print page_head('Compare configurations', $user, 'wide');
    print qq{<p class="breadcrumb"><a class="btn btn-green" href="}
        . esc(script_url() . '?action=tools') . qq{">&larr; Tools</a></p>\n};
    print qq{<h1>Compare configurations</h1>\n};

    # Exactly two selections; each is "current" or a valid backup name.
    my %seen;
    my @sel = grep { !$seen{$_}++ } $cgi->multi_param('sel');
    if (@sel != 2) {
        my $got = scalar @sel;
        print qq{<p class="error">Please select exactly two configurations to }
            . qq{compare (you selected $got). Go back to Tools, tick two, then }
            . qq{press Compare selected.</p>\n};
        print page_foot();
        return;
    }

    # Resolve each selection to (label, content, time), validating strictly.
    # 'time' orders the two sides so the OLDER goes left (red) and the NEWER
    # goes right (green): "current" is always newest; otherwise a backup's
    # timestamp (from its name) decides, newest = green.
    my @sides;
    for my $s (@sel) {
        if ($s eq 'current') {
            my ($content, $err) = slurp_device_table();
            if ($err) {
                print qq{<p class="error">} . esc($err) . qq{</p>\n};
                print page_foot();
                return;
            }
            push @sides, { label => 'current (live device table)',
                           content => $content, time => 9**9**9 };   # +inf = newest
        } else {
            my $path = resolve_backup_path($s);
            unless ($path) {
                print qq{<p class="error">No such backup: } . esc($s) . qq{</p>\n};
                print page_foot();
                return;
            }
            my $content = '';
            if (open(my $fh, '<', $path)) { local $/; $content = <$fh>; close($fh); }
            # Timestamp from the backup name "...YYYY-MM-DD_HHMMSS.bak";
            # fall back to the file mtime if it somehow doesn't parse.
            my $t;
            if ($s =~ /\.(\d{4})-(\d\d)-(\d\d)_(\d\d)(\d\d)(\d\d)\.bak$/) {
                $t = sprintf('%04d%02d%02d%02d%02d%02d', $1, $2, $3, $4, $5, $6);
            } else {
                my @st = stat($path); $t = @st ? $st[9] : 0;
            }
            push @sides, { label => $s, content => $content, time => $t };
        }
    }

    # Older first (left/red), newer second (right/green).
    @sides = sort { $a->{time} <=> $b->{time} } @sides;

    my $mode = $cgi->param('mode') // 'sidebyside';
    $mode = 'sidebyside' unless $mode eq 'unified' || $mode eq 'sidebyside';

    # Passwords masked by default; the "Mask passwords" checkbox (unchecked)
    # passes unmask=1.
    my $unmask = ($cgi->param('unmask') // '') eq '1';

    print qq{<p>Comparing <strong>} . esc($sides[0]{label}) . qq{</strong> (older) and }
        . qq{<strong>} . esc($sides[1]{label}) . qq{</strong> (newer). }
        . qq{Whitespace outside quoted text is ignored; passwords are }
        . ($unmask ? qq{shown in plain text} : qq{masked}) . qq{.</p>\n};

    # Normalize whitespace (quote-aware) before diffing, so tab/space-only
    # differences don't appear.
    my $left  = normalize_config_ws($sides[0]{content});
    my $right = normalize_config_ws($sides[1]{content});

    if ($mode eq 'unified') {
        my ($diff_text, $identical) = build_unified_diff($left, $right);
        if ($identical) {
            print qq{<p>The two configurations are identical.</p>\n};
        } else {
            print diff_legend_unified();
            print render_unified_diff($diff_text, $unmask);
        }
    } else {
        # render_side_by_side prints its own "identical" message + legend.
        print render_side_by_side($left, $right, $sides[0]{label}, $sides[1]{label}, $unmask);
    }

    print top_bottom_nav();
    print page_foot();
}

# JSON endpoint for the "Check devices for empty backups" scan: checks ONE
# device for zero-byte backups. Admin-only, read-only GET (no CSRF).
sub do_check_empty_one {
    my ($user) = @_;
    unless (user_may_use_tools($user)) {
        print $cgi->header(-type => 'application/json', -status => '403 Forbidden');
        print '{"error":"forbidden"}';
        return;
    }
    my $dev = $cgi->param('dev') // '';
    unless (valid_id($dev)) {
        print $cgi->header(-type => 'application/json', -status => '400 Bad Request');
        print '{"error":"bad device id"}';
        return;
    }
    my ($status, $detail) = device_empty_status($dev);
    # Return the failure detail too, so the scan UI can show WHY a device
    # could not be checked (a truncated read, a real non-zero exit, or a
    # spawn failure) instead of a bare "could not be checked".
    print $cgi->header(-type => 'application/json', -charset => 'UTF-8');
    if ($status eq 'error' && defined $detail && $detail ne '') {
        print qq({"dev":"$dev","status":"$status","detail":) . json_string($detail) . qq(});
    } else {
        print qq({"dev":"$dev","status":"$status"});
    }
}

